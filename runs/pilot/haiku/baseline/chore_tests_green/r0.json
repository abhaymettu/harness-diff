 "files": {
  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        dollars, cents = divmod(abs(self.cents), 100)\n        return f'{sign}${dollars:,}.{cents:02d}'\n\n    def split(self, n):\n        # Divide into n shares that sum exactly to self.cents.\n        # divmod gives a remainder in [0, n); the first `rem` shares get one extra cent.\n        share, rem = divmod(self.cents, n)\n        return [Money(share + 1 if i < rem else share) for i in range(n)]\n"
