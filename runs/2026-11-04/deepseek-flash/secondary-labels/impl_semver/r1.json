  "semver.py": "def _parse(version):\n    version = version.split(\"+\", 1)[0]\n    core, sep, pre = version.partition(\"-\")\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n    identifiers = None\n    if sep:\n        identifiers = tuple(\n            (0, int(part)) if part.isdigit() else (1, part)\n            for part in pre.split(\".\")\n        )\n    return major, minor, patch, identifiers\n\n\ndef sort_versions(vs):\n    def key(version):\n        major, minor, patch, pre = _parse(version)\n        return major, minor, patch, (1,) if pre is None else (0, pre)\n\n    return sorted(vs, key=key)\n"
