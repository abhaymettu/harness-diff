 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    y_prev = y - 1\n    leaps = y_prev // 4 - y_prev // 100 + y_prev // 400\n    total = y_prev * 365 + leaps + sum(DAYS[: m - 1])\n    if m > 2 and _is_leap(y):\n        total += 1\n    return total + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
