  "build_report.py": "import csv, json\n\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    users = list(csv.DictReader(f))\n\nuser_ids = {int(u['id']) for u in users}\ntotals = {int(u['id']): 0.0 for u in users}\n\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        order = json.loads(line)\n        if order.get('status') != 'paid':\n            continue\n        uid = int(order['user_id'])\n        if uid in user_ids:\n            totals[uid] += float(order['total'])\n\nreport = [\n    {\n        'user': u['name'],\n        'country': u['country'],\n        'paid_total': round(totals[int(u['id'])], 2),\n    }\n    for u in users\n]\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n    f.write('\\n')\n",
