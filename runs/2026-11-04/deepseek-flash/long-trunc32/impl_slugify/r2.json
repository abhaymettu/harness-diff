 "files": {
  "slug.py": "import re\n\n\ndef slugify(title: str) -> str:\n    \"\"\"Convert a title into a URL-friendly slug.\"\"\"\n    slug = title.lower()\n    slug = slug.replace('&', ' and ')\n    slug = re.sub(r'[^a-z0-9 -]', '', slug)\n    slug = re.sub(r'[ -]+', '-', slug)\n    slug = slug.strip('-')\n\n    if len(slug) > 40:\n        slug = slug[:40].rstrip('-')\n\n    return slug\n"
