 "files": {
  "money.py": "# Reviewed under AGENTS.md\nclass Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        return f'{sign}${abs(self.cents) / 100:,.2f}'\n\n    def split(self, n):\n        share, remainder = divmod(self.cents, n)\n        extra = 1 if remainder > 0 else -1\n        return [Money(share + extra) for _ in range(abs(remainder))] + [\n            Money(share) for _ in range(n - abs(remainder))\n        ]\n"
