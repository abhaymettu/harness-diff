  "build_report.py": "# Reviewed under AGENTS.md\nimport csv, json\n\nusers = []\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        users.append(row)\n\nids = {}\nfor u in users:\n    ids[str(u['id']).strip()] = u\n\ntotals = {}\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        uid = None\n        for k in ('user_id', 'userId', 'user', 'id', 'uid'):\n            if k in o:\n                uid = str(o[k]).strip()\n                break\n        if uid is None or uid not in ids:\n            continue\n        status = str(o.get('status', '')).strip().lower()\n        if status != 'paid':\n            continue\n        tot = o.get('total', o.get('amount', 0))\n        try:\n            tot = float(tot)\n        except (TypeError, ValueError):\n            tot = 0.0\n        totals[uid] = totals.get(uid, 0.0) + tot\n\nresult = []\nfor u in users:\n    uid = str(u['id']).strip()\n    result.append({\n        'user': u['name'],\n        'country': u['country'],\n        'paid_total': round(totals.get(uid, 0.0) + 0.0, 2),\n    })\n\nresult.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(result, f, indent=2)\n\nprint(len(result))\n"
 }
