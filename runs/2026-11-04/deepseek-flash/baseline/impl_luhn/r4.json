  "luhn.py": "def valid(number):\n    if not isinstance(number, str):\n        return False\n    digits = number.replace(\" \", \"\")\n    if len(digits) < 2:\n        return False\n    if not all(c.isdigit() and c in \"0123456789\" for c in digits):\n        return False\n    total = 0\n    # process from the right, doubling every second digit\n    for i, ch in enumerate(reversed(digits)):\n        d = ord(ch) - 48\n        if i % 2 == 1:\n            d *= 2\n            if d > 9:\n                d -= 9\n        total += d\n    return total % 10 == 0\n"
