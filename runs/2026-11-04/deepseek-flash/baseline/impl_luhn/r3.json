  "luhn.py": "def valid(number):\n    if not isinstance(number, str):\n        return False\n\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n\n    if any(c < \"0\" or c > \"9\" for c in digits):\n        return False\n\n    total = 0\n    for i, char in enumerate(reversed(digits)):\n        digit = ord(char) - ord(\"0\")\n        if i % 2 == 1:\n            digit *= 2\n            if digit > 9:\n                digit -= 9\n        total += digit\n\n    return total % 10 == 0\n"
