 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    # Days contributed by complete years before y (including their leap days).\n    days = y * 365 + (y - 1) // 4 - (y - 1) // 100 + (y - 1) // 400\n    # Days from complete months in the current year.\n    days += sum(DAYS[: m - 1])\n    # Leap day of the current year, if it has already passed.\n    if m > 2 and _is_leap(y):\n        days += 1\n    return days + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
