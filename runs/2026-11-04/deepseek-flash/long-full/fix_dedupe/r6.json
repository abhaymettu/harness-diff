  "util.py": "# Reviewed under AGENTS.md\nfrom __future__ import annotations\n\nfrom typing import Iterable, TypeVar\n\nT = TypeVar('T')\n\n\ndef dedupe(items: Iterable[T]) -> list[T]:\n    \"\"\"Remove repeated items, keeping the first occurrence of each in order.\n\n    Items may be unhashable (e.g. lists); equality is ordinary ``==``.\n    \"\"\"\n    result: list[T] = []\n    for item in items:\n        if not any(item == seen for seen in result):\n            result.append(item)\n    return result\n"
