  "semver.py": "\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _identifier_key(identifier):\n    # Numeric identifiers sort below alphanumeric ones; numbers compare as ints,\n    # alphanumerics compare in ASCII order.\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _version_key(version):\n    # Build metadata (after '+') does not affect precedence.\n    core_and_pre = version.split(\"+\", 1)[0]\n    # Core numbers contain no hyphens, so the first hyphen starts the pre-release.\n    core, _, pre = core_and_pre.partition(\"-\")\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n    if pre:\n        # A pre-release sorts below the release without one; tuple prefix rule\n        # makes a shorter identifier list lower when all shared ones are equal.\n        pre_key = (0, tuple(_identifier_key(i) for i in pre.split(\".\")))\n    else:\n        pre_key = (1, ())\n    return (major, minor, patch, pre_key)\n\n\ndef sort_versions(vs):\n    \"\"\"Return versions sorted lowest precedence first. Ties keep input order.\"\"\"\n    return sorted(vs, key=_version_key)\n"
