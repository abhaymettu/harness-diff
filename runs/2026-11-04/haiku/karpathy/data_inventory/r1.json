 "files": {
  "apply_transactions.py": "import json\n\nwith open(\"inventory.json\") as f:\n    counts = dict(json.load(f))\n\nwith open(\"transactions.txt\") as f:\n    lines = f.read().splitlines()\n\nrejected = []\nfor lineno, line in enumerate(lines, 1):\n    parts = line.split()\n    if not parts:\n        continue\n    op, sku, qty = parts[0], parts[1], int(parts[2])\n    if op == \"add\":\n        counts[sku] = counts.get(sku, 0) + qty\n    elif op == \"remove\":\n        cur = counts.get(sku)\n        if cur is None or cur - qty < 0:\n            rejected.append(lineno)\n        else:\n            counts[sku] = cur - qty\n    else:\n        raise ValueError(f\"unknown op on line {lineno}: {line!r}\")\n\nwith open(\"inventory_after.json\", \"w\") as f:\n    json.dump(counts, f, indent=2)\n    f.write(\"\\n\")\n\nwith open(\"rejected.txt\", \"w\") as f:\n    f.write(\"\".join(f\"{n}\\n\" for n in rejected))\n\nprint(\"rejected:\", rejected)\nprint(json.dumps(counts, indent=2))\n",
