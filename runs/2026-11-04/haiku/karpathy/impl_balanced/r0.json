  "brackets.py": "def balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    stack = []\n    in_str = False\n    i = 0\n    while i < len(s):\n        c = s[i]\n        if in_str:\n            if c == '\\\\':\n                i += 2\n                continue\n            if c == '\"':\n                in_str = False\n        elif c == '\"':\n            in_str = True\n        elif c in '([{':\n            stack.append(c)\n        elif c in pairs:\n            if not stack or stack[-1] != pairs[c]:\n                return False\n            stack.pop()\n        i += 1\n    return not in_str and not stack\n"
