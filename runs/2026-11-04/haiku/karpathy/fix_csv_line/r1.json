  "parse.py": "def split_csv(line):\n    fields = []\n    field = []\n    in_quotes = False\n    i = 0\n    n = len(line)\n    while i < n:\n        ch = line[i]\n        if in_quotes:\n            if ch == '\"':\n                if i + 1 < n and line[i + 1] == '\"':\n                    field.append('\"')\n                    i += 1\n                else:\n                    in_quotes = False\n            else:\n                field.append(ch)\n        elif ch == '\"':\n            in_quotes = True\n        elif ch == ',':\n            fields.append(''.join(field))\n            field = []\n        else:\n            field.append(ch)\n        i += 1\n    fields.append(''.join(field))\n    return fields\n"
