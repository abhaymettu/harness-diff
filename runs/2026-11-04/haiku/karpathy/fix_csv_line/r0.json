 "files": {
  "parse.py": "def split_csv(line):\n    fields = []\n    field = []\n    in_quotes = False\n    i = 0\n    while i < len(line):\n        c = line[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < len(line) and line[i + 1] == '\"':\n                    field.append('\"')\n                    i += 1\n                else:\n                    in_quotes = False\n            else:\n                field.append(c)\n        elif c == '\"':\n            in_quotes = True\n        elif c == ',':\n            fields.append(''.join(field))\n            field = []\n        else:\n            field.append(c)\n        i += 1\n    fields.append(''.join(field))\n    return fields\n"
 }
