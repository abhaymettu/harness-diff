  "rle.py": "import re\n\n\ndef encode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        j = i\n        while j < len(s) and s[j] == s[i]:\n            j += 1\n        run = j - i\n        out.append(s[i])\n        if run > 1:\n            out.append(str(run))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    out = []\n    for char, count in re.findall(r'([A-Za-z])(\\d*)', s):\n        out.append(char * (int(count) if count else 1))\n    return ''.join(out)\n"
