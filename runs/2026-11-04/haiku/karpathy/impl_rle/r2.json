  "rle.py": "import re\n\n\ndef encode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        j = i\n        while j < len(s) and s[j] == s[i]:\n            j += 1\n        count = j - i\n        out.append(s[i])\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    out = []\n    for char, digits in re.findall(r'([A-Za-z])(\\d*)', s):\n        count = int(digits) if digits else 1\n        out.append(char * count)\n    return ''.join(out)\n"
 }
