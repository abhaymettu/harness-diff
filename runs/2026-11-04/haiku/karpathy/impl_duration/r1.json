 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(r\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\")\n_UNIT_SECONDS = (86400, 3600, 60, 1)\n\n\ndef parse_duration(s):\n    \"\"\"Convert a duration string such as '1d2h', '1h30m' or '45s' to seconds.\n\n    Units d, h, m, s may each appear at most once, in that order. Surrounding\n    whitespace is ignored. Raises ValueError for anything else.\n    \"\"\"\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None:\n        raise ValueError(f\"invalid duration: {s!r}\")\n    return sum(\n        int(amount) * seconds\n        for amount, seconds in zip(match.groups(), _UNIT_SECONDS)\n        if amount is not None\n    )\n"
 }
