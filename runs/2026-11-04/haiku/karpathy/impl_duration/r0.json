 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(r'(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?')\n_MULTIPLIERS = (86400, 3600, 60, 1)\n\n\ndef parse_duration(s):\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None or not any(match.groups()):\n        raise ValueError(f\"invalid duration: {s!r}\")\n    return sum(int(g) * k for g, k in zip(match.groups(), _MULTIPLIERS) if g is not None)\n"
 }
