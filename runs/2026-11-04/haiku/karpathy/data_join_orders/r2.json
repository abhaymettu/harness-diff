 "files": {
  "make_report.py": "import csv\nimport json\nfrom decimal import Decimal, ROUND_HALF_UP\n\nUSER_KEYS = [\"user_id\", \"userId\", \"user\", \"customer_id\"]\nTOTAL_KEYS = [\"total\", \"amount\", \"total_amount\"]\n\n\ndef first(d, keys):\n    for k in keys:\n        if k in d:\n            return d[k]\n    raise KeyError(f\"none of {keys} in {list(d)}\")\n\n\nusers = []\nwith open(\"users.csv\", newline=\"\", encoding=\"utf-8\") as f:\n    for row in csv.DictReader(f):\n        users.append((str(row[\"id\"]).strip(), row[\"name\"], row[\"country\"]))\n\ntotals = {uid: Decimal(0) for uid, _, _ in users}\n\nwith open(\"orders.jsonl\", encoding=\"utf-8\") as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        if str(o.get(\"status\", \"\")).strip() != \"paid\":\n            continue\n        uid = str(first(o, USER_KEYS)).strip()\n        if uid in totals:\n            totals[uid] += Decimal(str(first(o, TOTAL_KEYS)))\n\nreport = []\nfor uid, name, country in users:\n    paid = totals[uid].quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    report.append({\"user\": name, \"country\": country, \"paid_total\": float(paid)})\n\nreport.sort(key=lambda r: (-r[\"paid_total\"], r[\"user\"]))\n\nwith open(\"report.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(report, f, indent=2)\n    f.write(\"\\n\")\n\nprint(json.dumps(report[:5], indent=2))\n",
