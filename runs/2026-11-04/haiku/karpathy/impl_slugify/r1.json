  "slug.py": "import re\n\n\ndef slugify(title):\n    s = title.lower().replace('&', ' and ')\n    s = re.sub(r'[^a-z0-9 -]', '', s)\n    s = re.sub(r'[ -]+', '-', s)\n    s = s.strip('-')\n    if len(s) > 40:\n        s = s[:40].rstrip('-')\n    return s\n"
