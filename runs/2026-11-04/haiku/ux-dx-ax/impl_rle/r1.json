 "files": {
  "rle.py": "import itertools\nimport re\n\n\ndef encode(s):\n    parts = []\n    for char, group in itertools.groupby(s):\n        count = sum(1 for _ in group)\n        parts.append(char if count == 1 else f\"{char}{count}\")\n    return \"\".join(parts)\n\n\ndef decode(s):\n    return \"\".join(\n        char * (int(count) if count else 1)\n        for char, count in re.findall(r\"([A-Za-z])(\\d*)\", s)\n    )\n"
 }
