 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Single spaces between digits are ignored. Returns False if there are\n    fewer than two digits after removing spaces, or if any character is\n    not a digit 0-9.\n    \"\"\"\n    digits = number.replace(\" \", \"\")\n    if len(digits) < 2:\n        return False\n    if not all(c in \"0123456789\" for c in digits):\n        return False\n\n    total = 0\n    for i, c in enumerate(reversed(digits)):\n        d = int(c)\n        if i % 2 == 1:\n            d *= 2\n            if d > 9:\n                d -= 9\n        total += d\n    return total % 10 == 0\n"
 }
