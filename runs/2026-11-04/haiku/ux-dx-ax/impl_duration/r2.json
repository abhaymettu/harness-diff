 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(r\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\")\n_UNIT_SECONDS = (86400, 3600, 60, 1)\n\n\ndef parse_duration(s):\n    \"\"\"Convert a duration like '1d2h', '1h30m' or '45s' to seconds.\"\"\"\n    if not isinstance(s, str):\n        raise ValueError(f\"expected a string, got {type(s).__name__}\")\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None or not any(match.groups()):\n        raise ValueError(f\"invalid duration: {s!r}\")\n    return sum(\n        int(amount) * unit\n        for amount, unit in zip(match.groups(), _UNIT_SECONDS)\n        if amount is not None\n    )\n"
 }
