  "brackets.py": "def balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    stack = []\n    in_str = False\n    escaped = False\n    for ch in s:\n        if in_str:\n            if escaped:\n                escaped = False\n            elif ch == '\\\\':\n                escaped = True\n            elif ch == '\"':\n                in_str = False\n            continue\n        if ch == '\"':\n            in_str = True\n        elif ch in '([{':\n            stack.append(ch)\n        elif ch in pairs:\n            if not stack or stack[-1] != pairs[ch]:\n                return False\n            stack.pop()\n    if in_str:\n        return False\n    return not stack\n"
