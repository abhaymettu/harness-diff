 "files": {
  "words.py": "import re\nfrom collections import Counter\n\nWORD_RE = re.compile(r\"[A-Za-z']+\")\n\n\ndef top_words(text, k):\n    counts = Counter(w.lower() for w in WORD_RE.findall(text))\n    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))\n    return ordered[:k]\n"
