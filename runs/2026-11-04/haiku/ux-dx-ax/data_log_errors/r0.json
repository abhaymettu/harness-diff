 "files": {
  "count_errors.py": "import csv\nimport re\nfrom collections import Counter\n\n# An entry starts with a timestamp (a digit at column 0). Continuation lines do not.\nENTRY = re.compile(r'^\\d\\S*.*?\\s\\[ERROR\\]\\s+([^:]+):')\n\ncounts = Counter()\nwith open('app.log', encoding='utf-8', errors='replace') as f:\n    for line in f:\n        line = line.rstrip('\\r\\n')\n        m = ENTRY.match(line)\n        if m:\n            counts[m.group(1).strip()] += 1\n\nrows = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))\nwith open('errors.csv', 'w', newline='', encoding='utf-8') as f:\n    w = csv.writer(f, lineterminator='\\n')\n    w.writerow(['module', 'errors'])\n    w.writerows(rows)\n\nwith open('errors.csv', encoding='utf-8') as f:\n    print(f.read(), end='')\n",
  "errors.csv": "module,errors\ndb,20\napi,18\ncache,12\nbilling,11\nsearch,9\nauth,7\n"
 }
