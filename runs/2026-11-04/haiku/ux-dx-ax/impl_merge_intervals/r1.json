  "intervals.py": "def merge(intervals):\n    \"\"\"Return the merged, sorted list of disjoint intervals.\n\n    Intervals that overlap or touch are combined. The input is not modified.\n    \"\"\"\n    merged = []\n    for start, end in sorted((s, e) for s, e in intervals):\n        if merged and start <= merged[-1][1]:\n            if end > merged[-1][1]:\n                merged[-1][1] = end\n        else:\n            merged.append([start, end])\n    return merged\n"
