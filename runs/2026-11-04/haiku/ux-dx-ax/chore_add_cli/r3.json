 "files": {
  "tool.py": "import argparse\n\n\ndef transform(text, upper=False, reverse=False):\n    if upper:\n        text = text.upper()\n    if reverse:\n        text = text[::-1]\n    return text\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=\"Apply transform() to TEXT.\")\n    parser.add_argument(\"--upper\", action=\"store_true\", help=\"convert to uppercase\")\n    parser.add_argument(\"--reverse\", action=\"store_true\", help=\"reverse the text\")\n    parser.add_argument(\"text\", nargs=\"*\", metavar=\"TEXT\")\n    args = parser.parse_args(argv)\n    if not args.text:\n        parser.error(\"the following arguments are required: TEXT\")\n    print(transform(\" \".join(args.text), upper=args.upper, reverse=args.reverse))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
 }
