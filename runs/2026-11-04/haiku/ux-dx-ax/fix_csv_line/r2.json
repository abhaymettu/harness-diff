   "reply": "\n{\"action\": \"write\", \"path\": \"parse.py\", \"content\": \"def split_csv(line):\\n    line = line.rstrip('\\\\r\\\\n')\\n    fields = []\\n    field = []\\n    in_quotes = False\\n    quoted = False  # the current field began with an opening quote\\n    i = 0\\n    n = len(line)\\n    while i < n:\\n        ch = line[i]\\n        if in_quotes:\\n            if ch == '\\\"':\\n                if i + 1 < n and line[i + 1] == '\\\"':\\n                    field.append('\\\"')\\n                    i += 2\\n                    continue\\n                in_quotes = False\\n            else:\\n                field.append(ch)\\n        elif ch == '\\\"' and not field and not quoted:\\n            in_quotes = True\\n            quoted = True\\n        elif ch == ',':\\n            fields.append(''.join(field))\\n            field = []\\n            quoted = False\\n        else:\\n            field.append(ch)\\n        i += 1\\n    fields.append(''.join(field))\\n    return fields\\n\"}",
