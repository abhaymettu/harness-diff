 "files": {
  "semver.py": "\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _identifier_key(identifier):\n    if identifier.isascii() and identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _precedence_key(version):\n    # Build metadata after '+' does not affect precedence.\n    core_and_pre = version.split(\"+\", 1)[0]\n    core, _, pre = core_and_pre.partition(\"-\")\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n\n    # A pre-release sorts below the release; a release uses an empty tuple\n    # marker that is greater than any pre-release tuple.\n    if pre:\n        pre_key = (0, tuple(_identifier_key(i) for i in pre.split(\".\")))\n    else:\n        pre_key = (1, ())\n\n    return (major, minor, patch, pre_key)\n\n\ndef sort_versions(vs):\n    \"\"\"Return the version strings in vs sorted lowest precedence first.\n\n    Ties keep their input order because sorted() is stable.\n    \"\"\"\n    return sorted(vs, key=_precedence_key)\n"
 }
