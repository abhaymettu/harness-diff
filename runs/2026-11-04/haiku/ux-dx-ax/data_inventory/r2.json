 "files": {
  "inventory_after.json": "{\n  \"apple\": 5,\n  \"bolt\": 6,\n  \"cable\": 9,\n  \"drill\": 6,\n  \"epoxy\": 10\n}\n",
  "process_inventory.py": "import json\n\nwith open(\"inventory.json\", encoding=\"utf-8\") as f:\n    inv = json.load(f)\n\nrejected = []\n\nwith open(\"transactions.txt\", encoding=\"utf-8\") as f:\n    for lineno, raw in enumerate(f, start=1):\n        line = raw.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) != 3:\n            rejected.append(lineno)\n            continue\n        op, sku, qty_s = parts\n        op = op.lower()\n        try:\n            qty = int(qty_s)\n        except ValueError:\n            rejected.append(lineno)\n            continue\n        if qty < 0 or op not in (\"add\", \"remove\"):\n            rejected.append(lineno)\n            continue\n        if op == \"add\":\n            inv[sku] = inv.get(sku, 0) + qty\n        else:\n            if sku not in inv or inv[sku] - qty < 0:\n                rejected.append(lineno)\n                continue\n            inv[sku] -= qty\n\nwith open(\"inventory_after.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(inv, f, indent=2)\n    f.write(\"\\n\")\n\nwith open(\"rejected.txt\", \"w\", encoding=\"utf-8\") as f:\n    for n in rejected:\n        f.write(f\"{n}\\n\")\n\nprint(\"final:\", json.dumps(inv, sort_keys=True))\nprint(\"rejected:\", rejected)\n",
