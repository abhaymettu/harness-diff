  "slug.py": "import re\n\nMAX_LENGTH = 40\n\n\ndef slugify(title):\n    s = title.lower()\n    s = s.replace('&', ' and ')\n    s = re.sub(r'[^a-z0-9 -]', '', s)\n    s = re.sub(r'[ -]+', '-', s)\n    s = s.strip('-')\n    if len(s) > MAX_LENGTH:\n        s = s[:MAX_LENGTH].rstrip('-')\n    return s\n"
