  "slug.py": "import re\n\nMAX_LENGTH = 40\n\n\ndef slugify(title):\n    text = title.lower()\n    text = text.replace(\"&\", \" and \")\n    text = re.sub(r\"[^a-z0-9 -]\", \"\", text)\n    text = re.sub(r\"[ -]+\", \"-\", text)\n    text = text.strip(\"-\")\n    if len(text) > MAX_LENGTH:\n        text = text[:MAX_LENGTH].rstrip(\"-\")\n    return text\n"
