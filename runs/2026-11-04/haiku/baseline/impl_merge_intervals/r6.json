  "intervals.py": "def merge(intervals):\n    \"\"\"Merge overlapping or touching [start, end] integer intervals.\n\n    Returns a new list of disjoint intervals sorted by start.\n    The input list is not modified.\n    \"\"\"\n    if not intervals:\n        return []\n\n    ordered = sorted((list(iv) for iv in intervals), key=lambda iv: iv[0])\n\n    merged = []\n    for start, end in ordered:\n        if merged and start <= merged[-1][1]:\n            if end > merged[-1][1]:\n                merged[-1][1] = end\n        else:\n            merged.append([start, end])\n    return merged\n"
 }
