  "rle.py": "import re\n\n\ndef encode(s):\n    \"\"\"Run-length encode s. Runs of length 1 omit the count.\"\"\"\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        j = i\n        while j < n and s[j] == ch:\n            j += 1\n        count = j - i\n        out.append(ch if count == 1 else f\"{ch}{count}\")\n        i = j\n    return \"\".join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Counts may have multiple digits.\"\"\"\n    out = []\n    for ch, digits in re.findall(r\"([^\\d])(\\d*)\", s):\n        count = int(digits) if digits else 1\n        out.append(ch * count)\n    return \"\".join(out)\n\n\nif __name__ == \"__main__\":\n    assert encode(\"aaabcc\") == \"a3bc2\"\n    assert decode(\"a3bc2\") == \"aaabcc\"\n    assert decode(encode(\"a\" * 12 + \"b\")) == \"a\" * 12 + \"b\"\n    assert encode(\"\") == \"\" and decode(\"\") == \"\"\n    print(\"ok\")\n"
 }
