  "rle.py": "import re\n\n\ndef encode(s):\n    \"\"\"Run-length encode s. Runs of length 1 omit the count.\"\"\"\n    out = []\n    i = 0\n    while i < len(s):\n        ch = s[i]\n        j = i\n        while j < len(s) and s[j] == ch:\n            j += 1\n        n = j - i\n        out.append(ch if n == 1 else f\"{ch}{n}\")\n        i = j\n    return \"\".join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Each letter is optionally followed by a multi-digit count.\"\"\"\n    out = []\n    for ch, count in re.findall(r\"([A-Za-z])(\\d*)\", s):\n        n = int(count) if count else 1\n        out.append(ch * n)\n    return \"\".join(out)\n\n\nif __name__ == \"__main__\":\n    assert encode(\"aaabcc\") == \"a3bc2\"\n    assert decode(\"a3bc2\") == \"aaabcc\"\n    assert decode(encode(\"a\" * 12 + \"b\")) == \"a\" * 12 + \"b\"\n    assert encode(\"\") == \"\" and decode(\"\") == \"\"\n    print(\"ok\")\n"
 }
