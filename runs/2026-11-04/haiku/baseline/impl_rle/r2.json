  "rle.py": "def encode(s):\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        j = i\n        while j < n and s[j] == ch:\n            j += 1\n        count = j - i\n        out.append(ch)\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        i += 1\n        j = i\n        while j < n and s[j].isdigit():\n            j += 1\n        count = int(s[i:j]) if j > i else 1\n        out.append(ch * count)\n        i = j\n    return ''.join(out)\n"
 }
