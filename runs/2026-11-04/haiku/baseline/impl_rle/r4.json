  "rle.py": "import re\n\n\ndef encode(s):\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        j = i\n        while j < n and s[j] == s[i]:\n            j += 1\n        count = j - i\n        out.append(s[i])\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    out = []\n    for match in re.finditer(r'([A-Za-z])(\\d*)', s):\n        ch, digits = match.group(1), match.group(2)\n        count = int(digits) if digits else 1\n        out.append(ch * count)\n    return ''.join(out)\n",
  "test_rle.py": "from rle import encode, decode\n\nassert encode('aaabcc') == 'a3bc2'\nassert encode('') == ''\nassert encode('a') == 'a'\nassert encode('aaaaaaaaaaaa') == 'a12'\nassert decode('a3bc2') == 'aaabcc'\nassert decode('a12') == 'a' * 12\nassert decode('') == ''\nfor s in ['aaabcc', 'abc', 'zzzzzzzzzzzzzzzzzzzzAB', 'aabbccdd']:\n    assert decode(encode(s)) == s\nprint('ok')\n"
 }
