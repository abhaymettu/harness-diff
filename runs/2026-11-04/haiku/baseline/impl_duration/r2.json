 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(\n    r\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\"\n)\n\n_SECONDS = (86400, 3600, 60, 1)\n\n\ndef parse_duration(s):\n    \"\"\"Convert a duration string such as '1h30m' or '1d2h' to seconds.\n\n    Units d, h, m, s may each appear at most once, in that order. Each amount\n    is a non-negative integer. Surrounding whitespace is ignored. Raises\n    ValueError for any other input, including the empty string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(f\"expected a string, got {type(s).__name__}\")\n\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None:\n        raise ValueError(f\"invalid duration: {s!r}\")\n\n    total = 0\n    for group, factor in zip(match.groups(), _SECONDS):\n        if group is not None:\n            total += int(group) * factor\n    return total\n"
 }
