 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(\n    r\"(?=.)\"\n    r\"(?:([0-9]+)d)?\"\n    r\"(?:([0-9]+)h)?\"\n    r\"(?:([0-9]+)m)?\"\n    r\"(?:([0-9]+)s)?\"\n)\n\n\ndef parse_duration(s):\n    \"\"\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\n\n    Units d, h, m, s may each appear at most once, in that order.\n    Surrounding whitespace is ignored. Raises ValueError on invalid input.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(f\"expected a string, got {type(s).__name__}\")\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if match is None or not text:\n        raise ValueError(f\"invalid duration: {s!r}\")\n    days, hours, minutes, seconds = (int(g) if g is not None else 0 for g in match.groups())\n    return days * 86400 + hours * 3600 + minutes * 60 + seconds\n"
