 "files": {
  "slug.py": "import re\n\n\ndef slugify(title):\n    # 1. lowercase\n    s = title.lower()\n    # 2. replace each '&' with ' and '\n    s = s.replace('&', ' and ')\n    # 3. drop every character that is not an ASCII letter, digit, space or hyphen\n    s = re.sub(r'[^a-z0-9 -]', '', s)\n    # 4. turn each run of spaces and hyphens into one hyphen\n    s = re.sub(r'[ -]+', '-', s)\n    # 5. strip hyphens from both ends\n    s = s.strip('-')\n    # 6. if longer than 40 characters, cut to 40 and strip any trailing hyphen\n    if len(s) > 40:\n        s = s[:40].rstrip('-')\n    return s\n"
 }
