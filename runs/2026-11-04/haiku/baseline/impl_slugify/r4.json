  "slug.py": "import string\n\n_ALLOWED = set(string.ascii_letters + string.digits + \" -\")\nMAX_LEN = 40\n\n\ndef slugify(title):\n    s = title.lower()\n    s = s.replace(\"&\", \" and \")\n    s = \"\".join(c for c in s if c in _ALLOWED)\n    s = \"-\".join(part for part in s.replace(\" \", \"-\").split(\"-\") if part)\n    if len(s) > MAX_LEN:\n        s = s[:MAX_LEN].rstrip(\"-\")\n    return s\n"
