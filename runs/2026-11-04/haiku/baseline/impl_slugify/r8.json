  "slug.py": "import re\n\nALLOWED = set(\"abcdefghijklmnopqrstuvwxyz0123456789 -\")\n\n\ndef slugify(title):\n    s = title.lower()\n    s = s.replace(\"&\", \" and \")\n    s = \"\".join(c for c in s if c in ALLOWED)\n    s = re.sub(r\"[ -]+\", \"-\", s)\n    s = s.strip(\"-\")\n    if len(s) > 40:\n        s = s[:40].rstrip(\"-\")\n    return s\n"
