 "files": {
  "make_report.py": "import csv, json\nfrom decimal import Decimal, ROUND_HALF_UP\n\ndef norm_id(x):\n    try:\n        return str(int(float(str(x).strip())))\n    except (ValueError, TypeError):\n        return str(x).strip()\n\ndef pick(d, names):\n    for n in names:\n        if n in d and d[n] is not None:\n            return d[n]\n    return None\n\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    users = []\n    for row in csv.DictReader(f):\n        row = {(k or '').strip(): (v or '').strip() for k, v in row.items()}\n        users.append(row)\n\ntotals = {}\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        uid = pick(o, ['user_id', 'userId', 'uid', 'user'])\n        status = pick(o, ['status'])\n        total = pick(o, ['total', 'amount', 'total_amount', 'price'])\n        if uid is None or status is None or total is None:\n            continue\n        if str(status).strip().lower() != 'paid':\n            continue\n        key = norm_id(uid)\n        totals[key] = totals.get(key, Decimal('0')) + Decimal(str(total))\n\nreport = []\nfor u in users:\n    amt = totals.get(norm_id(u['id']), Decimal('0'))\n    amt = amt.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    report.append({'user': u['name'], 'country': u['country'], 'paid_total': float(amt)})\n\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n\nprint(json.dumps(report, indent=2))\n",
