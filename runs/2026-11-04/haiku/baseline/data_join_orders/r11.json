 "files": {
  "make_report.py": "import csv, json, os\nfrom decimal import Decimal, ROUND_HALF_UP\n\nbase = os.getcwd()\n\nusers = []\nwith open(os.path.join(base, 'users.csv'), newline='', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        row = {k.strip(): (v.strip() if isinstance(v, str) else v) for k, v in row.items() if k}\n        users.append(row)\n\nby_id = {str(u['id']): u for u in users}\ntotals = {uid: Decimal('0') for uid in by_id}\n\ndef pick(d, *names):\n    for n in names:\n        if n in d:\n            return d[n]\n    for k in d:\n        for n in names:\n            if n in k.lower():\n                return d[k]\n    return None\n\nwith open(os.path.join(base, 'orders.jsonl'), encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        uid = pick(o, 'user_id', 'userId', 'user')\n        uid = str(uid).strip() if uid is not None else None\n        status = pick(o, 'status')\n        status = str(status).strip().lower() if status is not None else ''\n        total = pick(o, 'total', 'amount')\n        if uid in totals and status == 'paid' and total is not None:\n            totals[uid] += Decimal(str(total).strip())\n\nreport = []\nfor uid, u in by_id.items():\n    amt = totals[uid].quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    report.append({'user': u['name'], 'country': u['country'], 'paid_total': float(amt)})\n\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open(os.path.join(base, 'report.json'), 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n    f.write('\\n')\n",
