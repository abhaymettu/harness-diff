 "files": {
  "make_report.py": "import csv\nimport json\nfrom decimal import Decimal, ROUND_HALF_UP\n\nusers = []\nwith open('users.csv', newline='', encoding='utf-8-sig') as f:\n    for row in csv.DictReader(f):\n        row = {(k or '').strip(): (v or '').strip() for k, v in row.items()}\n        users.append(row)\n\nid_to_user = {u['id']: u for u in users}\ntotals = {u['id']: Decimal('0') for u in users}\n\nwith open('orders.jsonl', encoding='utf-8-sig') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        uid = str(o.get('user_id', o.get('user', o.get('userId', '')))).strip()\n        status = str(o.get('status', '')).strip().lower()\n        if uid not in totals or status != 'paid':\n            continue\n        total = o.get('total', o.get('amount', 0))\n        totals[uid] += Decimal(str(total))\n\nrows = []\nfor u in users:\n    amt = totals[u['id']].quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    rows.append({'user': u['name'], 'country': u['country'], 'paid_total': float(amt)})\n\nrows.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(rows, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(rows, indent=2))\n",
