 "files": {
  "make_report.py": "import csv\nimport json\nfrom decimal import Decimal, ROUND_HALF_UP, InvalidOperation\n\ndef pick(d, names):\n    for n in names:\n        if n in d:\n            return d[n]\n    for k in d:\n        for n in names:\n            if n in k.lower():\n                return d[k]\n    return None\n\nusers = {}\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        row = {k.strip(): (v.strip() if isinstance(v, str) else v) for k, v in row.items() if k}\n        uid = str(row['id']).strip()\n        users[uid] = {'name': row['name'], 'country': row['country'], 'total': Decimal('0')}\n\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            o = json.loads(line)\n        except json.JSONDecodeError:\n            continue\n        status = pick(o, ['status'])\n        if not isinstance(status, str) or status.strip().lower() != 'paid':\n            continue\n        uid = pick(o, ['user_id', 'userid', 'user', 'customer_id', 'customer'])\n        if uid is None:\n            continue\n        uid = str(uid).strip()\n        if uid.endswith('.0'):\n            uid = uid[:-2]\n        if uid not in users:\n            continue\n        total = pick(o, ['total', 'amount'])\n        try:\n            amt = Decimal(str(total).strip())\n        except (InvalidOperation, TypeError, ValueError):\n            continue\n        users[uid]['total'] += amt\n\nreport = []\nfor uid, u in users.items():\n    t = u['total'].quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    report.append({'user': u['name'], 'country': u['country'], 'paid_total': float(t)})\n\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n    f.write('\\n')\n\nprint(len(report), 'users written')\n",
