  "words.py": "import re\nfrom collections import Counter\n\n_WORD_RE = re.compile(r\"[A-Za-z']+\")\n\n\ndef top_words(text, k):\n    words = _WORD_RE.findall(text.lower())\n    counts = Counter(words)\n    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))\n    return ordered[:k]\n"
