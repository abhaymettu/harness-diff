  "parse.py": "def split_csv(line):\n    fields = []\n    current = []\n    in_quotes = False\n    i = 0\n    n = len(line)\n    while i < n:\n        ch = line[i]\n        if in_quotes:\n            if ch == '\"':\n                if i + 1 < n and line[i + 1] == '\"':\n                    current.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n            else:\n                current.append(ch)\n        else:\n            if ch == '\"':\n                in_quotes = True\n            elif ch == ',':\n                fields.append(''.join(current))\n                current = []\n            else:\n                current.append(ch)\n        i += 1\n    fields.append(''.join(current))\n    return fields\n"
 }
