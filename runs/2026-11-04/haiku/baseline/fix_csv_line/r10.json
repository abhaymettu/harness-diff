 "files": {
  "parse.py": "def split_csv(line):\n    fields = []\n    current = []\n    in_quotes = False\n    i = 0\n    n = len(line)\n    while i < n:\n        c = line[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < n and line[i + 1] == '\"':\n                    current.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n            else:\n                current.append(c)\n        else:\n            if c == '\"':\n                in_quotes = True\n            elif c == ',':\n                fields.append(''.join(current))\n                current = []\n            else:\n                current.append(c)\n        i += 1\n    fields.append(''.join(current))\n    return fields\n"
 }
