  "luhn.py": "def valid(number):\n    if not isinstance(number, str):\n        return False\n    stripped = number.replace(\" \", \"\")\n    if len(stripped) < 2:\n        return False\n    if not all(c in \"0123456789\" for c in stripped):\n        return False\n\n    total = 0\n    for i, c in enumerate(reversed(stripped)):\n        d = int(c)\n        if i % 2 == 1:\n            d *= 2\n            if d > 9:\n                d -= 9\n        total += d\n    return total % 10 == 0\n"
 }
