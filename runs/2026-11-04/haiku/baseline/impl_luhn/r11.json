 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if number (a string) passes the Luhn check.\n\n    Single spaces between digits are ignored. Returns False if, after removing\n    spaces, there are fewer than two characters or any non-digit character.\n    \"\"\"\n    if not isinstance(number, str):\n        return False\n\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n\n    if not all(\"0\" <= ch <= \"9\" for ch in digits):\n        return False\n\n    total = 0\n    # Walk from the rightmost digit; double every second digit.\n    for i, ch in enumerate(reversed(digits)):\n        d = ord(ch) - ord(\"0\")\n        if i % 2 == 1:\n            d *= 2\n            if d > 9:\n                d -= 9\n        total += d\n\n    return total % 10 == 0\n"
 }
