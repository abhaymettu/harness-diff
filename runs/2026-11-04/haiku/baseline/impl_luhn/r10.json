 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if the card number string passes the Luhn check.\n\n    Single spaces between digits are ignored. Returns False if there are\n    fewer than two digits after removing spaces, or if any character is\n    not a digit 0-9.\n    \"\"\"\n    if not isinstance(number, str):\n        return False\n\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n\n    for ch in digits:\n        if ch not in \"0123456789\":\n            return False\n\n    total = 0\n    # Walk from the rightmost digit; double every second digit.\n    for i, ch in enumerate(reversed(digits)):\n        d = int(ch)\n        if i % 2 == 1:\n            d *= 2\n            if d > 9:\n                d -= 9\n        total += d\n\n    return total % 10 == 0\n"
 }
