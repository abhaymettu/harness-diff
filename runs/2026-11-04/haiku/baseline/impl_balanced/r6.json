  "brackets.py": "def balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    openers = set(pairs.values())\n    stack = []\n    i = 0\n    n = len(s)\n    in_string = False\n    while i < n:\n        c = s[i]\n        if in_string:\n            if c == '\\\\':\n                i += 2\n                continue\n            if c == '\"':\n                in_string = False\n        else:\n            if c == '\"':\n                in_string = True\n            elif c in openers:\n                stack.append(c)\n            elif c in pairs:\n                if not stack or stack[-1] != pairs[c]:\n                    return False\n                stack.pop()\n        i += 1\n    if in_string:\n        return False\n    return not stack\n"
