  "brackets.py": "def balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    openers = set(pairs.values())\n    stack = []\n    i = 0\n    n = len(s)\n    while i < n:\n        c = s[i]\n        if c == '\"':\n            i += 1\n            closed = False\n            while i < n:\n                if s[i] == '\\\\':\n                    i += 2\n                    continue\n                if s[i] == '\"':\n                    closed = True\n                    break\n                i += 1\n            if not closed:\n                return False\n            i += 1\n            continue\n        if c in openers:\n            stack.append(c)\n        elif c in pairs:\n            if not stack or stack.pop() != pairs[c]:\n                return False\n        i += 1\n    return not stack\n"
 }
