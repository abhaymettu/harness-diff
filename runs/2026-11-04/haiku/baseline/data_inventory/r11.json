   "reply": "{\"action\": \"write\", \"path\": \"process.py\", \"content\": \"import json\\nimport sys\\n\\nwith open('inventory.json') as f:\\n    inv = json.load(f)\\n\\nrejected = []\\nwith open('transactions.txt') as f:\\n    lines = f.read().splitlines()\\n\\nfor lineno, raw in enumerate(lines, start=1):\\n    line = raw.strip()\\n    if not line:\\n        continue\\n    parts = line.split()\\n    ok = False\\n    if len(parts) == 3:\\n        op, sku, qs = parts\\n        try:\\n            qty = int(qs)\\n        except ValueError:\\n            qty = None\\n        if qty is not None:\\n            op = op.lower()\\n            if op == 'add':\\n                inv[sku] = inv.get(sku, 0) + qty\\n                ok = True\\n            elif op == 'remove':\\n                if sku in inv and inv[sku] - qty >= 0:\\n                    inv[sku] -= qty\\n                    ok = True\\n    if not ok:\\n        rejected.append(lineno)\\n\\nwith open('inventory_after.json', 'w') as f:\\n    json.dump(inv, f, indent=2)\\n    f.write('\\\\n')\\n\\nwith open('rejected.txt', 'w') as f:\\n    for n in rejected:\\n        f.write(f'{n}\\\\n')\\n\\nprint('rejected:', rejected)\\nprint(json.dumps(inv, indent=2))\\n\"}",
