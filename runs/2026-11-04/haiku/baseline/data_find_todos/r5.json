 "files": {
  "find_todos.py": "import os\nimport io\nimport sys\nimport tokenize\n\nroot = '.'\nresults = []\n\nfor dp, dns, fns in os.walk(root):\n    dns[:] = [d for d in dns if d != '.git']\n    for fn in fns:\n        if not fn.endswith('.py'):\n            continue\n        full = os.path.join(dp, fn)\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\n        try:\n            with tokenize.open(full) as f:\n                src = f.read()\n            for t in tokenize.generate_tokens(io.StringIO(src).readline):\n                if t.type == tokenize.COMMENT and 'TODO' in t.string:\n                    results.append((rel, t.start[0]))\n        except (tokenize.TokenError, SyntaxError, UnicodeDecodeError, OSError) as e:\n            print('skipped %s: %s' % (rel, e), file=sys.stderr)\n\nresults = sorted(set(results))\nwith open('todos.txt', 'w', encoding='utf-8') as out:\n    for p, l in results:\n        out.write('%s:%d\\n' % (p, l))\nprint('found %d' % len(results))\n",
