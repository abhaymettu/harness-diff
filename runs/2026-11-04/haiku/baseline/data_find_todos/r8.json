   "reply": "\n<invoke_action>\n{\"action\": \"run\", \"args\": [\"-c\", \"import os,tokenize\\nout=[]\\nfor root,dirs,files in os.walk('.'):\\n    dirs[:]=[d for d in dirs if d!='.git']\\n    for f in files:\\n        if not f.endswith('.py'):\\n            continue\\n        p=os.path.normpath(os.path.join(root,f))\\n        rel=p[2:] if p.startswith('./') else p\\n        rel=rel.replace(os.sep,'/')\\n        try:\\n            with tokenize.open(p) as fh:\\n                for tok in tokenize.generate_tokens(fh.readline):\\n                    if tok.type==tokenize.COMMENT and 'TODO' in tok.string:\\n                        out.append((rel,tok.start[0]))\\n        except (SyntaxError,tokenize.TokenError,UnicodeDecodeError,OSError):\\n            pass\\nout.sort()\\nopen('todos.txt','w').write(''.join('%s:%d\\\\n'%(r,l) for r,l in out))\\nprint(len(out))\\nfor r,l in out: print('%s:%d'%(r,l))\\n\"]}",
