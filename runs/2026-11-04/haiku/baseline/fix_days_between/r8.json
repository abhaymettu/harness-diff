  "check_dates.py": "from dates import days_between\n\ncases = [\n    ((\"2024-02-28\", \"2024-03-01\"), 2),\n    ((\"2023-02-28\", \"2023-03-01\"), 1),\n    ((\"2000-02-28\", \"2000-03-01\"), 2),\n    ((\"1900-02-28\", \"1900-03-01\"), 1),\n    ((\"2023-01-01\", \"2024-01-01\"), 365),\n    ((\"2024-01-01\", \"2025-01-01\"), 366),\n    ((\"2024-03-01\", \"2024-02-28\"), -2),\n    ((\"2024-01-15\", \"2024-01-15\"), 0),\n]\nfor (a, b), want in cases:\n    got = days_between(a, b)\n    assert got == want, (a, b, got, want)\nprint(\"all ok\")\n",
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    prev = y - 1\n    # Days in all complete years before year y (Gregorian rules).\n    days = prev * 365 + prev // 4 - prev // 100 + prev // 400\n    for i in range(m - 1):\n        days += DAYS[i]\n        if i == 1 and _is_leap(y):\n            days += 1\n    return days + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
