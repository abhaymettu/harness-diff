 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(year):\n    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    # Days in all full years before year y (proleptic Gregorian calendar).\n    prev = y - 1\n    days_before_year = prev * 365 + prev // 4 - prev // 100 + prev // 400\n    # Days in full months of year y before month m.\n    days_before_month = sum(DAYS[: m - 1])\n    if m > 2 and _is_leap(y):\n        days_before_month += 1\n    return days_before_year + days_before_month + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
 }
