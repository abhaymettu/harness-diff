 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _month_days(y, m):\n    if m == 2 and _is_leap(y):\n        return 29\n    return DAYS[m - 1]\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    prev = y - 1\n    days = prev * 365 + prev // 4 - prev // 100 + prev // 400\n    for mm in range(1, m):\n        days += _month_days(y, mm)\n    return days + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
 }
