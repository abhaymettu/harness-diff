   "reply": "\n{\"action\": \"write\", \"path\": \"dates.py\", \"content\": \"DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\\n\\n\\ndef _is_leap(y):\\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\\n\\n\\ndef _ordinal(s):\\n    y, m, d = map(int, s.split('-'))\\n    prev = y - 1\\n    # Days in all full years before y (proleptic Gregorian).\\n    days = prev * 365 + prev // 4 - prev // 100 + prev // 400\\n    # Days in full months of year y before month m.\\n    for i in range(m - 1):\\n        days += DAYS[i]\\n    if m > 2 and _is_leap(y):\\n        days += 1\\n    return days + d\\n\\n\\ndef days_between(a, b):\\n    return _ordinal(b) - _ordinal(a)\\n\"}",
