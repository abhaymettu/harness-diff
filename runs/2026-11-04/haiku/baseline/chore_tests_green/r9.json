  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        dollars, cents = divmod(abs(self.cents), 100)\n        return f'{sign}${dollars:,}.{cents:02d}'\n\n    def split(self, n):\n        sign = -1 if self.cents < 0 else 1\n        q, r = divmod(abs(self.cents), n)\n        # Distribute the remainder one cent at a time to the first shares,\n        # so the shares always sum exactly to the original amount.\n        return [Money(sign * (q + 1 if i < r else q)) for i in range(n)]\n"
