   "result": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        return f'${self.cents / 100:,.2f}'\n\n    def split(self, n):\n        share = self.cents // n\n        return [Money(share) for _ in range(n)]\n"
