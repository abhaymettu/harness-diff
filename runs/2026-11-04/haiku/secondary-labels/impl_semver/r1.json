  "semver.py": "def _key(version):\n    core = version.split('+', 1)[0]\n    main, _, pre = core.partition('-')\n    nums = tuple(int(part) for part in main.split('.'))\n    if not pre:\n        return (nums, 1, ())\n    ids = tuple(\n        (0, int(part), '') if part.isdigit() else (1, 0, part)\n        for part in pre.split('.')\n    )\n    return (nums, 0, ids)\n\n\ndef sort_versions(vs):\n    return sorted(vs, key=_key)\n"
