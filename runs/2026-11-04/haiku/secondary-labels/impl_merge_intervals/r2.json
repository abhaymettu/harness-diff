 "files": {
  "intervals.py": "def merge(intervals):\n    \"\"\"Return merged disjoint intervals sorted by start.\n\n    Intervals that overlap or touch are merged. The input is not modified.\n    \"\"\"\n    result = []\n    for start, end in sorted((s, e) for s, e in intervals):\n        if result and start <= result[-1][1]:\n            if end > result[-1][1]:\n                result[-1][1] = end\n        else:\n            result.append([start, end])\n    return result\n"
 }
