 "files": {
  "luhn.py": "def valid(number):\n    if not isinstance(number, str):\n        return False\n    stripped = number.replace(\" \", \"\")\n    if len(stripped) < 2:\n        return False\n    if not all(c in \"0123456789\" for c in stripped):\n        return False\n\n    total = 0\n    for i, c in enumerate(reversed(stripped)):\n        digit = int(c)\n        if i % 2 == 1:\n            digit *= 2\n            if digit > 9:\n                digit -= 9\n        total += digit\n    return total % 10 == 0\n"
 }
