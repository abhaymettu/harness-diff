 "files": {
  "brackets.py": "PAIRS = {')': '(', ']': '[', '}': '{'}\nOPENERS = set(PAIRS.values())\n\n\ndef balanced(s):\n    stack = []\n    in_string = False\n    escaped = False\n    for ch in s:\n        if in_string:\n            if escaped:\n                escaped = False\n            elif ch == '\\\\':\n                escaped = True\n            elif ch == '\"':\n                in_string = False\n        elif ch == '\"':\n            in_string = True\n        elif ch in OPENERS:\n            stack.append(ch)\n        elif ch in PAIRS:\n            if not stack or stack.pop() != PAIRS[ch]:\n                return False\n    return not in_string and not stack\n"
