 "files": {
  "make_report.py": "import csv\nimport json\nfrom collections import defaultdict\n\nusers = []\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        row = {k.strip(): (v.strip() if isinstance(v, str) else v) for k, v in row.items()}\n        users.append(row)\n\nuser_ids = {str(u['id']) for u in users}\nsums = defaultdict(float)\n\ndef pick(rec, names):\n    for n in names:\n        if n in rec and rec[n] is not None:\n            return rec[n]\n    return None\n\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        rec = json.loads(line)\n        uid = pick(rec, ['user_id', 'userId', 'user', 'customer_id', 'uid'])\n        status = pick(rec, ['status', 'state'])\n        total = pick(rec, ['total', 'amount', 'total_amount'])\n        if uid is None or status is None or total is None:\n            continue\n        if str(uid).strip() not in user_ids:\n            continue\n        if str(status).strip().lower() != 'paid':\n            continue\n        sums[str(uid).strip()] += float(total)\n\nreport = []\nfor u in users:\n    uid = str(u['id'])\n    report.append({\n        'user': u['name'],\n        'country': u['country'],\n        'paid_total': round(sums.get(uid, 0.0), 2),\n    })\n\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n\nprint(json.dumps(report[:5], indent=2))\n",
