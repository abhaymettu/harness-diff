  "tool.py": "import argparse\n\n\ndef transform(text, upper=False, reverse=False):\n    if upper:\n        text = text.upper()\n    if reverse:\n        text = text[::-1]\n    return text\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(prog=\"tool.py\")\n    parser.add_argument(\"--upper\", action=\"store_true\")\n    parser.add_argument(\"--reverse\", action=\"store_true\")\n    parser.add_argument(\"text\", nargs=\"+\")\n    args = parser.parse_args()\n    print(transform(\" \".join(args.text), upper=args.upper, reverse=args.reverse))\n    raise SystemExit(0)\n"
