  "rle.py": "import re\n\n\ndef encode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        j = i\n        while j < len(s) and s[j] == s[i]:\n            j += 1\n        n = j - i\n        out.append(s[i])\n        if n > 1:\n            out.append(str(n))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    return ''.join(\n        ch * (int(num) if num else 1)\n        for ch, num in re.findall(r'([A-Za-z])(\\d*)', s)\n    )\n"
