  "rle.py": "import re\n\n\ndef encode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        ch = s[i]\n        j = i\n        while j < len(s) and s[j] == ch:\n            j += 1\n        n = j - i\n        out.append(ch if n == 1 else f\"{ch}{n}\")\n        i = j\n    return \"\".join(out)\n\n\ndef decode(s):\n    return \"\".join(\n        ch * (int(num) if num else 1)\n        for ch, num in re.findall(r\"([A-Za-z])(\\d*)\", s)\n    )\n"
