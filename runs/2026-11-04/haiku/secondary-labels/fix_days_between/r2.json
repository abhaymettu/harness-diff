 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    prev = y - 1\n    days_before_year = prev * 365 + prev // 4 - prev // 100 + prev // 400\n    month_days = list(DAYS)\n    if _is_leap(y):\n        month_days[1] = 29\n    return days_before_year + sum(month_days[: m - 1]) + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
 }
