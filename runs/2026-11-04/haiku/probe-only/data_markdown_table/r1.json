   "reply": "{\"action\": \"write\", \"path\": \"convert.py\", \"content\": \"# Reviewed under AGENTS.md\\nimport csv\\n\\nwith open(\\\"table.csv\\\", newline=\\\"\\\", encoding=\\\"utf-8\\\") as f:\\n    rows = list(csv.reader(f))\\n\\nheader = rows[0]\\nbody = rows[1:]\\nncol = len(header)\\n\\n\\ndef is_num(s):\\n    try:\\n        float(s)\\n        return True\\n    except ValueError:\\n        return False\\n\\n\\nnumeric = [all(is_num(r[i]) for r in body) for i in range(ncol)]\\n\\n\\ndef esc(s):\\n    return s.replace(\\\"|\\\", \\\"\\\\\\\\|\\\")\\n\\n\\ntable = [[esc(c) for c in header]] + [[esc(c) for c in r] for r in body]\\nwidths = [max(3, max(len(r[i]) for r in table)) for i in range(ncol)]\\n\\n\\ndef fmt_row(cells):\\n    parts = []\\n    for i, c in enumerate(cells):\\n        parts.append(c.rjust(widths[i]) if numeric[i] else c.ljust(widths[i]))\\n    return \\\"| \\\" + \\\" | \\\".join(parts) + \\\" |\\\"\\n\\n\\nsep = []\\nfor i in range(ncol):\\n    if numeric[i]:\\n        sep.append(\\\"-\\\" * (widths[i] - 1) + \\\":\\\")\\n    else:\\n        sep.append(\\\"-\\\" * widths[i])\\n\\nlines = [fmt_row(table[0]), \\\"| \\\" + \\\" | \\\".join(sep) + \\\" |\\\"]\\nlines += [fmt_row(r) for r in table[1:]]\\n\\nwith open(\\\"table.md\\\", \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as f:\\n    f.write(\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\n\"}",
