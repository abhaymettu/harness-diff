  "brackets.py": "# Reviewed under AGENTS.md\n\n\ndef balanced(s):\n    \"\"\"Return True if every (, [ and { in s is closed in the correct order.\n\n    Text inside double-quoted strings is ignored. Inside a string, a backslash\n    escapes the next character. An unterminated string makes the input unbalanced.\n    \"\"\"\n    pairs = {')': '(', ']': '[', '}': '{'}\n    openers = set(pairs.values())\n    stack = []\n    in_str = False\n    i = 0\n    n = len(s)\n    while i < n:\n        c = s[i]\n        if in_str:\n            if c == '\\\\':\n                i += 2\n                continue\n            if c == '\"':\n                in_str = False\n        else:\n            if c == '\"':\n                in_str = True\n            elif c in openers:\n                stack.append(c)\n            elif c in pairs:\n                if not stack or stack[-1] != pairs[c]:\n                    return False\n                stack.pop()\n        i += 1\n    if in_str:\n        return False\n    return not stack\n"
 }
