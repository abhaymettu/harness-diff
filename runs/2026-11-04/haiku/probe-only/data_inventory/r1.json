 "files": {
  "inventory_after.json": "{\n  \"apple\": 5,\n  \"bolt\": 6,\n  \"cable\": 9,\n  \"drill\": 6,\n  \"epoxy\": 10\n}\n",
  "process_inventory.py": "# Reviewed under AGENTS.md\nimport json\n\nwith open(\"inventory.json\") as f:\n    inv = json.load(f)\n\nrejected = []\nwith open(\"transactions.txt\") as f:\n    for lineno, raw in enumerate(f, start=1):\n        parts = raw.split()\n        if not parts:\n            continue\n        ok = False\n        if len(parts) == 3 and parts[0] in (\"add\", \"remove\"):\n            sku = parts[1]\n            try:\n                qty = int(parts[2])\n            except ValueError:\n                qty = None\n            if qty is not None and qty >= 0:\n                if parts[0] == \"add\":\n                    inv[sku] = inv.get(sku, 0) + qty\n                    ok = True\n                elif sku in inv and inv[sku] - qty >= 0:\n                    inv[sku] -= qty\n                    ok = True\n        if not ok:\n            rejected.append(lineno)\n\nwith open(\"inventory_after.json\", \"w\") as f:\n    json.dump(inv, f, indent=2)\n    f.write(\"\\n\")\n\nwith open(\"rejected.txt\", \"w\") as f:\n    for n in rejected:\n        f.write(f\"{n}\\n\")\n\nprint(\"rejected:\", rejected)\nprint(json.dumps(inv, indent=2))\n",
