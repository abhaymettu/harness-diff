  "luhn.py": "# Reviewed under AGENTS.md\n\nDIGITS = \"0123456789\"\n\n\ndef valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Spaces are removed before checking. Returns False if fewer than two\n    characters remain or if any remaining character is not a digit 0-9.\n    \"\"\"\n    stripped = number.replace(\" \", \"\")\n    if len(stripped) < 2:\n        return False\n    if any(ch not in DIGITS for ch in stripped):\n        return False\n\n    total = 0\n    for position, ch in enumerate(reversed(stripped)):\n        digit = int(ch)\n        if position % 2 == 1:\n            digit *= 2\n            if digit > 9:\n                digit -= 9\n        total += digit\n    return total % 10 == 0\n"
 }
