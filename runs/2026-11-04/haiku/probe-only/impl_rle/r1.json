 "files": {
  "rle.py": "# Reviewed under AGENTS.md\nimport re\n\n\ndef encode(s):\n    \"\"\"Run-length encode s. Runs of length 1 omit the count.\"\"\"\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        j = i\n        while j < n and s[j] == ch:\n            j += 1\n        count = j - i\n        out.append(ch)\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Handles multi-digit run lengths.\"\"\"\n    out = []\n    for ch, count in re.findall(r'([A-Za-z])(\\d*)', s):\n        n = int(count) if count else 1\n        out.append(ch * n)\n    return ''.join(out)\n"
 }
