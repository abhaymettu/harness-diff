   "reply": "\n<invoke:action>\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"# Reviewed under AGENTS.md\\nimport re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode s: runs become the character followed by its count,\\n    with the count omitted when it is 1. Input contains only letters.\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode. Each letter is optionally followed by a multi-digit\\n    run length; a missing length means a run of 1.\\\"\\\"\\\"\\n    out = []\\n    for m in re.finditer(r'([A-Za-z])(\\\\d*)', s):\\n        ch, digits = m.group(1), m.group(2)\\n        count = int(digits) if digits else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\"}\n:::\n{\"action\": \"run\", \"args\": [\"-c\", \"import rle; assert rle.encode('aaabcc')=='a3bc2'; assert rle.decode('a3bc2')=='aaabcc'; assert rle.decode(rle.encode('a'*12+'b'))=='a'*12+'b'; assert rle.encode('')=='' and rle.decode('')==''; print('ok')\"]}",
