  "semver.py": "# Reviewed under AGENTS.md\n\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _identifier_key(identifier):\n    \"\"\"Numeric identifiers sort before alphanumeric ones; numeric compare as ints.\"\"\"\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _version_key(version):\n    \"\"\"Build a sort key for one version string. Build metadata is ignored.\"\"\"\n    core = version.split(\"+\", 1)[0]\n    if \"-\" in core:\n        numbers, pre = core.split(\"-\", 1)\n    else:\n        numbers, pre = core, None\n\n    major, minor, patch = (int(part) for part in numbers.split(\".\"))\n\n    if pre is None:\n        # A release sorts above any pre-release of the same version.\n        return (major, minor, patch, 1, ())\n\n    identifiers = tuple(_identifier_key(part) for part in pre.split(\".\"))\n    # Tuple comparison gives left-to-right order and shorter-prefix-is-lower.\n    return (major, minor, patch, 0, identifiers)\n\n\ndef sort_versions(vs):\n    \"\"\"Return the versions sorted lowest precedence first.\n\n    Versions with equal precedence keep their input order (sorted is stable).\n    \"\"\"\n    return sorted(vs, key=_version_key)\n"
 }
