   "reply": "\n<invoke:\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"\\\"\\\"\\\"Parse compact duration strings such as '1h30m' into seconds.\\\"\\\"\\\"\\n\\nimport re\\n\\n_UNIT_SECONDS = {\\\"d\\\": 86400, \\\"h\\\": 3600, \\\"m\\\": 60, \\\"s\\\": 1}\\n\\n# Each unit is optional, but they must appear in order d, h, m, s, each at most once.\\n_PATTERN = re.compile(\\n    r\\\"^[ \\\\t\\\\n\\\\r\\\\f\\\\v]*\\\"\\n    r\\\"(?:([0-9]+)d)?\\\"\\n    r\\\"(?:([0-9]+)h)?\\\"\\n    r\\\"(?:([0-9]+)m)?\\\"\\n    r\\\"(?:([0-9]+)s)?\\\"\\n    r\\\"[ \\\\t\\\\n\\\\r\\\\f\\\\v]*$\\\"\\n)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Return the number of seconds (int) described by the string ``s``.\\n\\n    Accepted units are d, h, m and s. Each unit may appear at most once, in\\n    that order, with a non-negative integer amount. Surrounding whitespace is\\n    allowed. Raises ValueError for anything else.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, got {type(s).__name__}\\\")\\n\\n    match = _PATTERN.fullmatch(s)\\n    if match is None:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    amounts = match.groups()\\n    if all(a is None for a in amounts):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    total = 0\\n    for amount, unit in zip(amounts, _UNIT_SECONDS):\\n        if amount is not None:\\n            total += int(amount) * _UNIT_SECONDS[unit]\\n    return total\\n\"}",
