 "files": {
  "duration.py": "import re\n\n_DURATION_RE = re.compile(\n    r\"([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?\"\n)\n\n_UNIT_SECONDS = {\"d\": 86400, \"h\": 3600, \"m\": 60, \"s\": 1}\n\n\ndef parse_duration(s):\n    \"\"\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\n\n    Units are d, h, m and s, each appearing at most once and in that order.\n    Each amount is a non-negative integer. Surrounding whitespace is allowed.\n    Raises ValueError for anything else.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(f\"duration must be a string, not {type(s).__name__}\")\n\n    text = s.strip()\n    if not text:\n        raise ValueError(\"empty duration string\")\n\n    match = _DURATION_RE.fullmatch(text)\n    if match is None:\n        raise ValueError(f\"invalid duration: {s!r}\")\n\n    total = 0\n    for group in match.groups():\n        if group is None:\n            continue\n        total += int(group[:-1]) * _UNIT_SECONDS[group[-1]]\n    return total\n"
 }
