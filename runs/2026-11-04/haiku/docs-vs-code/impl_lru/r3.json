 "files": {
  "lru.py": "from collections import OrderedDict\n\n\nclass LRUCache:\n    \"\"\"A fixed-capacity least-recently-used cache.\n\n    get() and put() both count as a use of the key. When inserting a new key\n    would exceed capacity, the least recently used key is evicted first.\n    \"\"\"\n\n    def __init__(self, capacity):\n        if capacity < 1:\n            raise ValueError(\"capacity must be at least 1\")\n        self.capacity = capacity\n        self._data = OrderedDict()\n\n    def get(self, key):\n        \"\"\"Return the value for key, or None if absent. Marks key as recently used.\"\"\"\n        if key not in self._data:\n            return None\n        self._data.move_to_end(key)\n        return self._data[key]\n\n    def put(self, key, value):\n        \"\"\"Insert or update key. Marks key as recently used, evicting the LRU key if needed.\"\"\"\n        if key in self._data:\n            self._data[key] = value\n            self._data.move_to_end(key)\n            return\n        if len(self._data) >= self.capacity:\n            self._data.popitem(last=False)\n        self._data[key] = value\n\n    def __len__(self):\n        return len(self._data)\n"
 }
