 "files": {
  "brackets.py": "def balanced(s):\n    \"\"\"Return True if every (, [ and { in s is closed by the matching\n    bracket in the correct order. Text inside double-quoted strings is\n    ignored; inside a string a backslash escapes the next character.\n    An unterminated string makes the input unbalanced.\"\"\"\n    pairs = {')': '(', ']': '[', '}': '{'}\n    openers = set(pairs.values())\n    stack = []\n    i = 0\n    n = len(s)\n    while i < n:\n        c = s[i]\n        if c == '\"':\n            i += 1\n            closed = False\n            while i < n:\n                if s[i] == '\\\\':\n                    i += 2\n                    continue\n                if s[i] == '\"':\n                    closed = True\n                    break\n                i += 1\n            if not closed:\n                return False\n            i += 1\n            continue\n        if c in openers:\n            stack.append(c)\n        elif c in pairs:\n            if not stack or stack[-1] != pairs[c]:\n                return False\n            stack.pop()\n        i += 1\n    return not stack\n"
 }
