 "files": {
  "words.py": "import re\nfrom collections import Counter\n\n\n_WORD_RE = re.compile(r\"[A-Za-z']+\")\n\n\ndef top_words(text, k):\n    counts = Counter(m.group(0).lower() for m in _WORD_RE.finditer(text))\n    ordered = sorted(counts.items(), key=lambda wc: (-wc[1], wc[0]))\n    return ordered[:k]\n"
