 "files": {
  "words.py": "import re\nfrom collections import Counter\n\n\n_WORD_RE = re.compile(r\"[A-Za-z']+\")\n\n\ndef top_words(text, k):\n    counts = Counter(_WORD_RE.findall(text.lower()))\n    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))\n    return ordered[:k]\n"
