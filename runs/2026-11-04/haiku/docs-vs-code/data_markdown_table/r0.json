 "files": {
  "make_table.py": "import csv\n\nwith open('table.csv', newline='') as f:\n    rows = list(csv.reader(f))\n\nheader, body = rows[0], rows[1:]\nncol = len(header)\n\ndef esc(s):\n    return s.replace('|', '\\\\|')\n\ndef is_num(s):\n    try:\n        float(s.strip())\n        return True\n    except ValueError:\n        return False\n\nnumeric = [all(is_num(r[i]) for r in body) for i in range(ncol)]\n\nhdr = [esc(c) for c in header]\nbod = [[esc(c) for c in r] for r in body]\n\nwidths = []\nfor i in range(ncol):\n    w = max([len(hdr[i])] + [len(r[i]) for r in bod])\n    widths.append(max(w, 3))\n\ndef fmt(cells):\n    out = []\n    for i, c in enumerate(cells):\n        if numeric[i]:\n            out.append(c.rjust(widths[i]))\n        else:\n            out.append(c.ljust(widths[i]))\n    return '| ' + ' | '.join(out) + ' |'\n\nlines = [fmt(hdr)]\nseps = []\nfor i in range(ncol):\n    if numeric[i]:\n        seps.append('-' * (widths[i] - 1) + ':')\n    else:\n        seps.append('-' * widths[i])\nlines.append('| ' + ' | '.join(seps) + ' |')\nfor r in bod:\n    lines.append(fmt(r))\n\nwith open('table.md', 'w', newline='') as f:\n    f.write('\\n'.join(lines) + '\\n')\n",
