 "files": {
  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        dollars, cents = divmod(abs(self.cents), 100)\n        return f'{sign}${dollars:,}.{cents:02d}'\n\n    def split(self, n):\n        # Divide into n parts whose cents sum exactly to self.cents.\n        # The remainder is spread one cent at a time over the first parts.\n        q, r = divmod(self.cents, n)\n        return [Money(q + 1 if i < r else q) for i in range(n)]\n"
 }
