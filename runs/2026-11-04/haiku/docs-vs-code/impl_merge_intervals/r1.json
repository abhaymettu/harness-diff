  "intervals.py": "def merge(intervals):\n    \"\"\"Merge overlapping or touching [start, end] integer intervals.\n\n    Accepts a list of [start, end] pairs (start <= end) in any order and\n    returns a new list of disjoint intervals sorted by start. Intervals that\n    overlap or touch (e.g. [1, 3] and [3, 5]) are merged. The input list and\n    its inner pairs are not modified.\n    \"\"\"\n    result = []\n    for start, end in sorted((s, e) for s, e in intervals):\n        if result and start <= result[-1][1]:\n            if end > result[-1][1]:\n                result[-1][1] = end\n        else:\n            result.append([start, end])\n    return result\n"
