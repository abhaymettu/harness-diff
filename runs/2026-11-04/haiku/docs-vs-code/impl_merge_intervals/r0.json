  "intervals.py": "def merge(intervals):\n    \"\"\"Merge overlapping or touching [start, end] integer intervals.\n\n    Accepts a list of [start, end] pairs (start <= end) in any order and\n    returns a new list of disjoint intervals sorted by start. Intervals that\n    overlap or touch (e.g. [1, 3] and [3, 5]) are merged. The input list is\n    not modified.\n    \"\"\"\n    if not intervals:\n        return []\n\n    ordered = sorted((start, end) for start, end in intervals)\n\n    merged = []\n    cur_start, cur_end = ordered[0]\n    for start, end in ordered[1:]:\n        if start <= cur_end:\n            if end > cur_end:\n                cur_end = end\n        else:\n            merged.append([cur_start, cur_end])\n            cur_start, cur_end = start, end\n    merged.append([cur_start, cur_end])\n    return merged\n"
