 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    # Days in all complete years before y, including Gregorian leap days.\n    prior = y - 1\n    days = prior * 365 + prior // 4 - prior // 100 + prior // 400\n    # Days in complete months of year y.\n    days += sum(DAYS[: m - 1])\n    if m > 2 and _is_leap(y):\n        days += 1\n    return days + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
 }
