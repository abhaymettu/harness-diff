 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    prev = y - 1\n    # Leap days in all full years before y (Gregorian rules).\n    leap_days = prev // 4 - prev // 100 + prev // 400\n    days_in_year = sum(DAYS[: m - 1]) + (1 if m > 2 and _is_leap(y) else 0)\n    return prev * 365 + leap_days + days_in_year + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
