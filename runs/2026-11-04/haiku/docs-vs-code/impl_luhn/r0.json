 "files": {
  "luhn.py": "\"\"\"Validate card numbers with the Luhn algorithm.\"\"\"\n\nDIGITS = \"0123456789\"\n\n\ndef valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Spaces are removed before checking. Returns False if fewer than two\n    characters remain or if any remaining character is not a digit 0-9.\n    \"\"\"\n    digits = number.replace(\" \", \"\")\n    if len(digits) < 2:\n        return False\n    if any(ch not in DIGITS for ch in digits):\n        return False\n\n    total = 0\n    for index, ch in enumerate(reversed(digits)):\n        value = int(ch)\n        if index % 2 == 1:\n            value *= 2\n            if value > 9:\n                value -= 9\n        total += value\n    return total % 10 == 0\n"
 }
