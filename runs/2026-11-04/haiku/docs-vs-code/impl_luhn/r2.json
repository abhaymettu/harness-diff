 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Single spaces between digits are ignored. Returns False if, after\n    removing spaces, there are fewer than two characters or any character\n    is not a digit 0-9.\n    \"\"\"\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n    if not all(\"0\" <= ch <= \"9\" for ch in digits):\n        return False\n\n    total = 0\n    for index, ch in enumerate(reversed(digits)):\n        value = int(ch)\n        if index % 2 == 1:\n            value *= 2\n            if value > 9:\n                value -= 9\n        total += value\n\n    return total % 10 == 0\n"
 }
