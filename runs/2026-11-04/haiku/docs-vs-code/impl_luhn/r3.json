 "files": {
  "luhn.py": "\"\"\"Validate card numbers with the Luhn algorithm.\"\"\"\n\nDIGITS = \"0123456789\"\n\n\ndef valid(number):\n    \"\"\"Return True if `number` is a valid Luhn card number, else False.\n\n    Spaces are removed before checking. The remaining string must contain\n    at least two characters, all of which are ASCII digits 0-9.\n    \"\"\"\n    stripped = number.replace(\" \", \"\")\n    if len(stripped) < 2:\n        return False\n    if any(ch not in DIGITS for ch in stripped):\n        return False\n\n    total = 0\n    for index, ch in enumerate(reversed(stripped)):\n        digit = int(ch)\n        if index % 2 == 1:\n            digit *= 2\n            if digit > 9:\n                digit -= 9\n        total += digit\n    return total % 10 == 0\n"
 }
