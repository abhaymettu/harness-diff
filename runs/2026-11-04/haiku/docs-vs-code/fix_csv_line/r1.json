 "files": {
  "parse.py": "def split_csv(line):\n    line = line.rstrip('\\r\\n')\n    fields = []\n    field = []\n    in_quotes = False\n    i = 0\n    n = len(line)\n    while i < n:\n        c = line[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < n and line[i + 1] == '\"':\n                    field.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n            else:\n                field.append(c)\n        else:\n            if c == ',':\n                fields.append(''.join(field))\n                field = []\n            elif c == '\"' and not field:\n                in_quotes = True\n            else:\n                field.append(c)\n        i += 1\n    fields.append(''.join(field))\n    return fields\n"
 }
