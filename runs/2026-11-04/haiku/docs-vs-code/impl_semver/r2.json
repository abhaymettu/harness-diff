  "semver.py": "\"\"\"Semantic Version 2.0.0 sorting utilities.\"\"\"\n\n\ndef _identifier_key(identifier):\n    \"\"\"Numeric identifiers sort below alphanumeric ones; each group sorts naturally.\"\"\"\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _version_key(version):\n    \"\"\"Build a key whose natural ordering matches SemVer 2.0.0 precedence.\"\"\"\n    # Build metadata (after '+') is ignored for precedence.\n    core_and_pre, _, _ = version.partition(\"+\")\n    # The first hyphen starts the pre-release; the core has no hyphens.\n    core, _, pre = core_and_pre.partition(\"-\")\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n\n    if pre:\n        # A pre-release sorts below the release without one.\n        pre_key = (0, tuple(_identifier_key(ident) for ident in pre.split(\".\")))\n    else:\n        pre_key = (1, ())\n\n    return (major, minor, patch, pre_key)\n\n\ndef sort_versions(vs):\n    \"\"\"Return the semantic version strings in vs sorted by precedence, lowest first.\n\n    Versions with equal precedence keep their input order (sort is stable).\n    \"\"\"\n    return sorted(vs, key=_version_key)\n"
