   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Semantic version sorting per SemVer 2.0.0 precedence rules.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(identifier):\\n    # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n    if identifier.isdigit():\\n        return (0, int(identifier), \\\"\\\")\\n    # Alphanumeric identifiers compare in ASCII order.\\n    return (1, 0, identifier)\\n\\n\\ndef _precedence_key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # The pre-release starts at the first hyphen; later hyphens belong to it.\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same version.\\n        pre_key = (1, ())\\n    else:\\n        # A shorter identifier list is lower when all shared ones are equal;\\n        # tuple comparison already gives that behavior.\\n        pre_key = (0, tuple(_identifier_key(p) for p in pre.split(\\\".\\\")))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted by SemVer precedence, lowest first.\\n\\n    Versions that compare equal keep their input order (sorted() is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
