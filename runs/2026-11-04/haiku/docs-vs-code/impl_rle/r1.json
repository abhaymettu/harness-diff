 "files": {
  "rle.py": "import re\nimport sys\n\n\ndef encode(s):\n    \"\"\"Run-length encode s. Each run becomes its character followed by the\n    run length, omitted when the length is 1: encode('aaabcc') == 'a3bc2'.\"\"\"\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        j = i\n        while j < n and s[j] == s[i]:\n            j += 1\n        count = j - i\n        out.append(s[i])\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Run lengths may have multiple digits.\"\"\"\n    out = []\n    for match in re.finditer(r'([A-Za-z])(\\d*)', s):\n        char, digits = match.group(1), match.group(2)\n        count = int(digits) if digits else 1\n        out.append(char * count)\n    return ''.join(out)\n\n\nif __name__ == '__main__':\n    if len(sys.argv) == 3 and sys.argv[1] in ('encode', 'decode'):\n        func = encode if sys.argv[1] == 'encode' else decode\n        print(func(sys.argv[2]))\n    else:\n        print('usage: rle.py encode|decode STRING', file=sys.stderr)\n        sys.exit(1)\n"
 }
