 "files": {
  "rle.py": "import re\n\n\ndef encode(s):\n    \"\"\"Run-length encode s: runs of the same character become the character\n    followed by the run length, omitted when the length is 1.\n\n    encode('aaabcc') == 'a3bc2'\n    \"\"\"\n    if not s:\n        return ''\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        j = i\n        while j < n and s[j] == ch:\n            j += 1\n        count = j - i\n        out.append(ch)\n        if count > 1:\n            out.append(str(count))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Run lengths may have more than one digit.\n\n    decode('a3bc2') == 'aaabcc'\n    \"\"\"\n    if not s:\n        return ''\n    out = []\n    for match in re.finditer(r'([A-Za-z])(\\d*)', s):\n        ch, digits = match.group(1), match.group(2)\n        count = int(digits) if digits else 1\n        out.append(ch * count)\n    return ''.join(out)\n"
 }
