   "reply": "\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"\\\"\\\"\\\"Run-length encoding for strings of letters.\\n\\nencode('aaabcc') == 'a3bc2'\\n\\\"\\\"\\\"\\n\\nimport re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Replace each run of the same character with the character followed by\\n    the run length. The length is omitted when the run is exactly 1.\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\n_TOKEN = re.compile(r'([^0-9])([0-9]*)')\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode. Each character is followed by an optional\\n    (possibly multi-digit) run length; no length means a run of 1.\\\"\\\"\\\"\\n    out = []\\n    for ch, digits in _TOKEN.findall(s):\\n        count = int(digits) if digits else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\"}",
