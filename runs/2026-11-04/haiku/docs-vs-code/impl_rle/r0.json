 "files": {
  "rle.py": "import re\n\n\ndef encode(s):\n    \"\"\"Run-length encode s. A run of length 1 is written without a count.\n\n    encode('aaabcc') == 'a3bc2'\n    \"\"\"\n    out = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        j = i\n        while j < n and s[j] == ch:\n            j += 1\n        count = j - i\n        out.append(ch if count == 1 else f\"{ch}{count}\")\n        i = j\n    return \"\".join(out)\n\n\ndef decode(s):\n    \"\"\"Inverse of encode. Handles multi-digit run lengths.\n\n    decode('a3bc2') == 'aaabcc'\n    \"\"\"\n    out = []\n    for ch, digits in re.findall(r\"([A-Za-z])(\\d*)\", s):\n        count = int(digits) if digits else 1\n        out.append(ch * count)\n    return \"\".join(out)\n"
