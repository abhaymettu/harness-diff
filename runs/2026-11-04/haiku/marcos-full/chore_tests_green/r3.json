 "files": {
  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        whole, frac = divmod(abs(self.cents), 100)\n        return f'{sign}${whole:,}.{frac:02d}'\n\n    def split(self, n):\n        # Divide into n parts that sum exactly to self.cents. The first\n        # `rem` parts receive one extra cent, where rem is the non-negative\n        # remainder of the division.\n        base, rem = divmod(self.cents, n)\n        return [Money(base + 1 if i < rem else base) for i in range(n)]\n"
