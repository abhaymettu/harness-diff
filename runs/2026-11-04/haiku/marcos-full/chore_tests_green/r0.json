 "files": {
  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        dollars, cents = divmod(abs(self.cents), 100)\n        return f'{sign}${dollars:,}.{cents:02d}'\n\n    def split(self, n):\n        # Distribute the cents so the shares sum exactly to the original amount.\n        # The first `remainder` shares each receive one extra cent.\n        quotient, remainder = divmod(self.cents, n)\n        return [Money(quotient + 1 if i < remainder else quotient) for i in range(n)]\n"
