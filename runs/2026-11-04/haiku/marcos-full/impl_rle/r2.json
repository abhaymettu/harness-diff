 "files": {
  "rle.py": "import itertools\nimport re\n\n\ndef encode(s):\n    parts = []\n    for ch, group in itertools.groupby(s):\n        n = len(list(group))\n        parts.append(ch if n == 1 else f\"{ch}{n}\")\n    return \"\".join(parts)\n\n\ndef decode(s):\n    return \"\".join(\n        ch * (int(num) if num else 1)\n        for ch, num in re.findall(r\"([A-Za-z])(\\d*)\", s)\n    )\n"
 }
