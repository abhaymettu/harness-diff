  "rle.py": "import re\nfrom itertools import groupby\n\n\ndef encode(s):\n    out = []\n    for ch, group in groupby(s):\n        n = sum(1 for _ in group)\n        out.append(ch if n == 1 else f\"{ch}{n}\")\n    return \"\".join(out)\n\n\ndef decode(s):\n    return \"\".join(\n        ch * (int(count) if count else 1)\n        for ch, count in re.findall(r\"([A-Za-z])(\\d*)\", s)\n    )\n"
 }
