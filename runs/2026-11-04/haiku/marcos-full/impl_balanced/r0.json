  "brackets.py": "def balanced(s):\n    pairs = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n    stack = []\n    in_string = False\n    escaped = False\n\n    for ch in s:\n        if in_string:\n            if escaped:\n                escaped = False\n            elif ch == \"\\\\\":\n                escaped = True\n            elif ch == '\"':\n                in_string = False\n            continue\n\n        if ch == '\"':\n            in_string = True\n        elif ch in \"([{\":\n            stack.append(ch)\n        elif ch in pairs:\n            if not stack or stack[-1] != pairs[ch]:\n                return False\n            stack.pop()\n\n    return not in_string and not stack\n"
