 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Single spaces between digits are ignored. Returns False if fewer than two\n    digits remain after removing spaces, or if any non-digit character appears.\n    \"\"\"\n    digits = number.replace(\" \", \"\")\n    if len(digits) < 2:\n        return False\n    if not all(c in \"0123456789\" for c in digits):\n        return False\n\n    total = 0\n    for index, char in enumerate(reversed(digits)):\n        value = int(char)\n        if index % 2 == 1:\n            value *= 2\n            if value > 9:\n                value -= 9\n        total += value\n    return total % 10 == 0\n"
 }
