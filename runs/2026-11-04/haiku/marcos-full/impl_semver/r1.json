 "files": {
  "semver.py": "\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _identifier_key(identifier):\n    # Numeric identifiers sort below alphanumeric ones; numbers compare as integers.\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _version_key(version):\n    # Build metadata after '+' is ignored for precedence.\n    core, _, _ = version.partition(\"+\")\n    core, _, prerelease = core.partition(\"-\")\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n\n    if prerelease:\n        # A pre-release sorts below the same version without one.\n        # Python tuple/list comparison gives the shorter-prefix-is-lower rule.\n        identifiers = tuple(_identifier_key(i) for i in prerelease.split(\".\"))\n        return (major, minor, patch, 0, identifiers)\n\n    return (major, minor, patch, 1, ())\n\n\ndef sort_versions(vs):\n    \"\"\"Return the versions sorted lowest precedence first.\n\n    Sorting is stable, so versions that tie keep their input order.\n    \"\"\"\n    return sorted(vs, key=_version_key)\n"
