  "semver.py": "\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _identifier_key(identifier):\n    # Numeric identifiers sort before alphanumeric ones; numerics compare as integers,\n    # alphanumerics compare in ASCII order.\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _version_key(version):\n    # Build metadata (after '+') is ignored for precedence.\n    core_and_pre = version.split(\"+\", 1)[0]\n    core, _, prerelease = core_and_pre.partition(\"-\")\n\n    major, minor, patch = (int(part) for part in core.split(\".\"))\n\n    if prerelease:\n        # Pre-release versions sort before the release (flag 0 < 1).\n        pre_key = (0, tuple(_identifier_key(i) for i in prerelease.split(\".\")))\n    else:\n        pre_key = (1, ())\n\n    return (major, minor, patch, pre_key)\n\n\ndef sort_versions(vs):\n    \"\"\"Return the version strings in vs sorted by SemVer precedence, lowest first.\n\n    Versions that compare equal keep their input order.\n    \"\"\"\n    return sorted(vs, key=_version_key)\n"
