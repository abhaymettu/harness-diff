  "intervals.py": "def merge(intervals):\n    \"\"\"Merge overlapping or touching [start, end] integer intervals.\n\n    Returns a new list of disjoint intervals sorted by start. The input is not modified.\n    \"\"\"\n    result = []\n    for start, end in sorted((s, e) for s, e in intervals):\n        if result and start <= result[-1][1]:\n            result[-1][1] = max(result[-1][1], end)\n        else:\n            result.append([start, end])\n    return result\n"
