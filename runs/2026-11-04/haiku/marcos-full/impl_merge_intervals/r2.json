  "intervals.py": "def merge(intervals):\n    \"\"\"Return the merged, disjoint intervals sorted by start.\n\n    Intervals that overlap or touch are merged. The input list is not modified.\n    \"\"\"\n    result = []\n    for start, end in sorted(intervals, key=lambda iv: iv[0]):\n        if result and start <= result[-1][1]:\n            if end > result[-1][1]:\n                result[-1][1] = end\n        else:\n            result.append([start, end])\n    return result\n"
 }
