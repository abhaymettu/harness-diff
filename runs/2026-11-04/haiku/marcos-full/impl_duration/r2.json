 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(r\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\")\n_UNIT_SECONDS = (86400, 3600, 60, 1)\n\n\ndef parse_duration(s: str) -> int:\n    \"\"\"Convert a duration such as '1d2h', '1h30m', '45s' into seconds.\n\n    Units d, h, m, s may each appear at most once, in that order. Each amount\n    is a non-negative integer. Surrounding whitespace is ignored.\n\n    Raises ValueError for anything else, including an empty string.\n    \"\"\"\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None:\n        raise ValueError(f\"invalid duration: {s!r}\")\n    return sum(\n        int(amount) * unit\n        for amount, unit in zip(match.groups(), _UNIT_SECONDS)\n        if amount is not None\n    )\n"
 }
