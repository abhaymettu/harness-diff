 "files": {
  "duration.py": "import re\n\n_PATTERN = re.compile(\n    r\"\"\"\n    (?:(?P<d>[0-9]+)d)?\n    (?:(?P<h>[0-9]+)h)?\n    (?:(?P<m>[0-9]+)m)?\n    (?:(?P<s>[0-9]+)s)?\n    \"\"\",\n    re.VERBOSE,\n)\n\n_UNIT_SECONDS = {\"d\": 86400, \"h\": 3600, \"m\": 60, \"s\": 1}\n\n\ndef parse_duration(s: str) -> int:\n    \"\"\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\n\n    Units d, h, m, s may each appear at most once, in that order. Each amount\n    is a non-negative integer. Surrounding whitespace is allowed. Raises\n    ValueError for any other input, including the empty string.\n    \"\"\"\n    text = s.strip()\n    match = _PATTERN.fullmatch(text)\n    if not text or match is None:\n        raise ValueError(f\"invalid duration: {s!r}\")\n\n    total = 0\n    for unit, seconds in _UNIT_SECONDS.items():\n        amount = match.group(unit)\n        if amount is not None:\n            total += int(amount) * seconds\n    return total\n"
 }
