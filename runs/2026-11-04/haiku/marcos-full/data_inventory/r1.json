   "reply": "\n{\"action\": \"write\", \"path\": \"apply_transactions.py\", \"content\": \"import json\\n\\nwith open(\\\"inventory.json\\\") as f:\\n    inv = json.load(f)\\n\\nrejected = []\\nwith open(\\\"transactions.txt\\\") as f:\\n    for n, line in enumerate(f, 1):\\n        parts = line.split()\\n        if not parts:\\n            continue\\n        ok = False\\n        if len(parts) == 3 and parts[0] in (\\\"add\\\", \\\"remove\\\"):\\n            try:\\n                qty = int(parts[2])\\n            except ValueError:\\n                qty = -1\\n            sku = parts[1]\\n            if qty >= 0:\\n                if parts[0] == \\\"add\\\":\\n                    inv[sku] = inv.get(sku, 0) + qty\\n                    ok = True\\n                elif sku in inv and inv[sku] - qty >= 0:\\n                    inv[sku] -= qty\\n                    ok = True\\n        if not ok:\\n            rejected.append(n)\\n\\nwith open(\\\"inventory_after.json\\\", \\\"w\\\") as f:\\n    json.dump(inv, f, indent=2)\\n    f.write(\\\"\\\\n\\\")\\n\\nwith open(\\\"rejected.txt\\\", \\\"w\\\") as f:\\n    f.write(\\\"\\\".join(f\\\"{n}\\\\n\\\" for n in rejected))\\n\"}",
