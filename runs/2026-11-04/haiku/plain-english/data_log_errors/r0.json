 "files": {
  "count_errors.py": "import csv\nimport collections\nimport re\n\n# A log entry starts with a digit (the timestamp), then [LEVEL], then module, then a colon.\npat = re.compile(r'^\\d[^\\[]*\\[(\\w+)\\]\\s+([^:]+?):')\n\ncounts = collections.Counter()\nwith open('app.log', encoding='utf-8', errors='replace') as f:\n    for line in f:\n        m = pat.match(line)\n        if m and m.group(1) == 'ERROR':\n            counts[m.group(2).strip()] += 1\n\nrows = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))\nwith open('errors.csv', 'w', newline='', encoding='utf-8') as f:\n    w = csv.writer(f)\n    w.writerow(['module', 'errors'])\n    w.writerows(rows)\n\nprint(rows)\n",
  "errors.csv": "module,errors\ndb,20\napi,18\ncache,12\nbilling,11\nsearch,9\nauth,7\n"
