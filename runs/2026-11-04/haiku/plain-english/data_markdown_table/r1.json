  "convert_table.py": "import csv\n\nwith open('table.csv', newline='', encoding='utf-8') as f:\n    rows = list(csv.reader(f))\n\nheader = rows[0]\nbody = rows[1:]\nncol = len(header)\n\n\ndef esc(s):\n    return s.replace('|', '\\\\|')\n\n\ndef is_num(s):\n    try:\n        float(s)\n        return True\n    except ValueError:\n        return False\n\n\nnumeric = [all(is_num(r[i]) for r in body) for i in range(ncol)]\n\ncells = [[esc(c) for c in r] for r in rows]\n\nwidths = []\nfor i in range(ncol):\n    w = max(len(r[i]) for r in cells)\n    widths.append(max(3, w))\n\n\ndef fmt_row(r):\n    out = []\n    for i in range(ncol):\n        if numeric[i]:\n            out.append(r[i].rjust(widths[i]))\n        else:\n            out.append(r[i].ljust(widths[i]))\n    return '| ' + ' | '.join(out) + ' |'\n\n\nsep = []\nfor i in range(ncol):\n    if numeric[i]:\n        sep.append('-' * (widths[i] - 1) + ':')\n    else:\n        sep.append('-' * widths[i])\n\nlines = [fmt_row(cells[0]), '| ' + ' | '.join(sep) + ' |']\nfor r in cells[1:]:\n    lines.append(fmt_row(r))\n\nwith open('table.md', 'w', encoding='utf-8', newline='\n') as f:\n    f.write('\\n'.join(lines) + '\\n')\n",
