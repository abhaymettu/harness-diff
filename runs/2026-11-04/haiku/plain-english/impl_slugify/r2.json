  "slug.py": "import re\n\n\ndef slugify(title):\n    # Rule 1: lowercase\n    s = title.lower()\n    # Rule 2: replace each '&' with ' and '\n    s = s.replace('&', ' and ')\n    # Rule 3: drop every character that is not an ASCII letter, digit, space or hyphen\n    s = ''.join(c for c in s if c.isascii() and (c.isalnum() or c in ' -'))\n    # Rule 4: turn each run of spaces and hyphens into one hyphen\n    s = re.sub(r'[ -]+', '-', s)\n    # Rule 5: strip hyphens from both ends\n    s = s.strip('-')\n    # Rule 6: if longer than 40 characters, cut to 40 and strip any trailing hyphen\n    if len(s) > 40:\n        s = s[:40].rstrip('-')\n    return s\n"
 }
