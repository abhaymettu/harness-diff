   "reply": "{\"action\": \"write\", \"path\": \"stats.py\", \"content\": \"def median(xs):\\n    if len(xs) == 0:\\n        raise ValueError(\\\"median() arg is an empty sequence\\\")\\n    ordered = sorted(xs)\\n    n = len(ordered)\\n    mid = n // 2\\n    if n % 2 == 1:\\n        return ordered[mid]\\n    return (ordered[mid - 1] + ordered[mid]) / 2\\n\"}",
