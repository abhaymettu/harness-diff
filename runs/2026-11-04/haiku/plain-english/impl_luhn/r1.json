 "files": {
  "luhn.py": "\"\"\"Check card numbers with the Luhn algorithm.\"\"\"\n\nDIGITS = \"0123456789\"\n\n\ndef valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Spaces are removed before checking. Return False if there are fewer\n    than two characters left, or if any character is not a digit 0-9.\n    \"\"\"\n    cleaned = number.replace(\" \", \"\")\n\n    if len(cleaned) < 2:\n        return False\n\n    for ch in cleaned:\n        if ch not in DIGITS:\n            return False\n\n    total = 0\n    # Walk from the rightmost digit to the left.\n    for position, ch in enumerate(reversed(cleaned)):\n        digit = int(ch)\n        # Double every second digit (counting from the right).\n        if position % 2 == 1:\n            digit *= 2\n            if digit > 9:\n                digit -= 9\n        total += digit\n\n    return total % 10 == 0\n"
 }
