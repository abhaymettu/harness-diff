 "files": {
  "luhn.py": "\"\"\"Check card numbers with the Luhn algorithm.\"\"\"\n\nDIGITS = \"0123456789\"\n\n\ndef valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Spaces are removed before checking. The input is invalid (False) if\n    there are fewer than two characters left, or if any character is\n    not a digit from 0 to 9.\n    \"\"\"\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n\n    for char in digits:\n        if char not in DIGITS:\n            return False\n\n    total = 0\n    # Walk from the rightmost digit to the left.\n    # Double every second digit; if the result is over 9, subtract 9.\n    for position, char in enumerate(reversed(digits)):\n        value = int(char)\n        if position % 2 == 1:\n            value *= 2\n            if value > 9:\n                value -= 9\n        total += value\n\n    return total % 10 == 0\n"
 }
