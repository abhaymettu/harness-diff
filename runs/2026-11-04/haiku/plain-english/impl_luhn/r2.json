 "files": {
  "luhn.py": "def valid(number):\n    \"\"\"Return True if the card number passes the Luhn check.\n\n    Spaces are removed before checking. The number must have at least\n    two characters, and every remaining character must be a digit 0-9.\n    \"\"\"\n    if not isinstance(number, str):\n        return False\n\n    digits = number.replace(\" \", \"\")\n\n    if len(digits) < 2:\n        return False\n\n    for ch in digits:\n        if ch not in \"0123456789\":\n            return False\n\n    total = 0\n    # Walk from the rightmost digit to the leftmost one.\n    for position, ch in enumerate(reversed(digits)):\n        value = int(ch)\n        # Double every second digit, counting from the right.\n        if position % 2 == 1:\n            value *= 2\n            if value > 9:\n                value -= 9\n        total += value\n\n    return total % 10 == 0\n"
 }
