 "files": {
  "dates.py": "DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n\ndef _is_leap(y):\n    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\n\ndef _ordinal(s):\n    y, m, d = map(int, s.split('-'))\n    # Days in all full years before year y, counting leap days.\n    prev = y - 1\n    days = 365 * prev + prev // 4 - prev // 100 + prev // 400\n    # Days in full months of year y before month m.\n    for i in range(m - 1):\n        days += DAYS[i] + (1 if i == 1 and _is_leap(y) else 0)\n    return days + d\n\n\ndef days_between(a, b):\n    return _ordinal(b) - _ordinal(a)\n"
