  "semver.py": "\"\"\"Sort semantic version strings by SemVer 2.0.0 precedence.\"\"\"\n\n\ndef _parse(version):\n    \"\"\"Return (major, minor, patch, pre_release_identifiers) for a version string.\n\n    Build metadata (after '+') is dropped because it does not affect ordering.\n    \"\"\"\n    core = version.split(\"+\", 1)[0]\n    if \"-\" in core:\n        base, pre = core.split(\"-\", 1)\n        pre_ids = pre.split(\".\")\n    else:\n        base = core\n        pre_ids = None\n    major, minor, patch = (int(part) for part in base.split(\".\"))\n    return major, minor, patch, pre_ids\n\n\ndef _identifier_key(identifier):\n    \"\"\"Numeric identifiers are lower than alphanumeric ones.\n\n    Numeric identifiers compare as integers; alphanumeric ones compare in ASCII order.\n    \"\"\"\n    if identifier.isdigit():\n        return (0, int(identifier), \"\")\n    return (1, 0, identifier)\n\n\ndef _precedence_key(version):\n    major, minor, patch, pre_ids = _parse(version)\n    if pre_ids is None:\n        # A normal release is higher than any pre-release of the same version.\n        return (major, minor, patch, 1, ())\n    # Tuple comparison makes a shorter list lower when the shared parts are equal.\n    return (\n        major,\n        minor,\n        patch,\n        0,\n        tuple(_identifier_key(ident) for ident in pre_ids),\n    )\n\n\ndef sort_versions(vs):\n    \"\"\"Return the version strings in vs sorted from lowest to highest precedence.\n\n    Versions that compare equal keep their input order (sorted() is stable).\n    \"\"\"\n    return sorted(vs, key=_precedence_key)\n",
