  "rle.py": "def encode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        j = i\n        while j < len(s) and s[j] == s[i]:\n            j += 1\n        n = j - i\n        out.append(s[i])\n        if n > 1:\n            out.append(str(n))\n        i = j\n    return ''.join(out)\n\n\ndef decode(s):\n    out = []\n    i = 0\n    while i < len(s):\n        ch = s[i]\n        i += 1\n        j = i\n        while j < len(s) and '0' <= s[j] <= '9':\n            j += 1\n        n = int(s[i:j]) if j > i else 1\n        out.append(ch * n)\n        i = j\n    return ''.join(out)\n"
 }
