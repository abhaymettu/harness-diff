 "files": {
  "make_report.py": "import csv\nimport json\nimport re\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom collections import defaultdict\n\n\ndef norm_key(k):\n    return re.sub(r'[^a-z]', '', str(k).strip().lower())\n\n\ndef norm_id(v):\n    s = str(v).strip()\n    if s.isdigit():\n        return str(int(s))\n    return s\n\n\ndef to_decimal(v):\n    s = re.sub(r'[^0-9.\\-]', '', str(v))\n    if s in ('', '-', '.'):\n        return Decimal('0')\n    return Decimal(s)\n\n\nusers = {}\nwith open('users.csv', newline='', encoding='utf-8-sig') as f:\n    for row in csv.DictReader(f):\n        r = {norm_key(k): (v or '').strip() for k, v in row.items() if k is not None}\n        uid = norm_id(r.get('id', ''))\n        users[uid] = {'name': r.get('name', ''), 'country': r.get('country', '')}\n\nsums = defaultdict(lambda: Decimal('0'))\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        nk = {norm_key(k): v for k, v in o.items()}\n        uid = None\n        for key in ('userid', 'customerid', 'user', 'uid', 'customer'):\n            if nk.get(key) is not None:\n                uid = norm_id(nk[key])\n                break\n        status = str(nk.get('status', '')).strip().lower()\n        total = nk.get('total', nk.get('amount'))\n        if status != 'paid' or uid is None or uid not in users or total is None:\n            continue\n        sums[uid] += to_decimal(total)\n\nreport = []\nfor uid, info in users.items():\n    t = sums[uid].quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    report.append({'user': info['name'], 'country': info['country'], 'paid_total': float(t)})\n\nreport.sort(key=lambda x: (-x['paid_total'], x['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2, ensure_ascii=False)\n    f.write('\\n')\n\nprint(json.dumps(report, indent=2, ensure_ascii=False))\nprint('users:', len(users), 'orders-with-known-users-sums:', len(sums))\n",
