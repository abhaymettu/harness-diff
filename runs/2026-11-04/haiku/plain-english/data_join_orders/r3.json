  "make_report.py": "import csv\nimport json\nfrom collections import defaultdict\nfrom decimal import Decimal, ROUND_HALF_UP\n\nusers = []\nwith open('users.csv', newline='', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        users.append({\n            'id': str(row['id']).strip(),\n            'name': str(row['name']).strip(),\n            'country': str(row['country']).strip(),\n        })\n\nuser_ids = set(u['id'] for u in users)\n\ndef get_user_id(o):\n    for k in ('user_id', 'userId', 'user', 'customer_id', 'customer'):\n        if k in o and o[k] is not None:\n            v = o[k]\n            if isinstance(v, dict):\n                v = v.get('id')\n            return str(v).strip()\n    return None\n\ndef get_total(o):\n    for k in ('total', 'amount', 'total_amount', 'order_total'):\n        if k in o and o[k] is not None:\n            return Decimal(str(o[k]).strip())\n    return Decimal('0')\n\ndef get_status(o):\n    v = o.get('status')\n    return '' if v is None else str(v).strip().lower()\n\ntotals = defaultdict(lambda: Decimal('0'))\nwith open('orders.jsonl', encoding='utf-8') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        o = json.loads(line)\n        if get_status(o) != 'paid':\n            continue\n        uid = get_user_id(o)\n        if uid in user_ids:\n            totals[uid] += get_total(o)\n\nreport = []\nfor u in users:\n    pt = totals[u['id']].quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    report.append({'user': u['name'], 'country': u['country'], 'paid_total': float(pt)})\n\nreport.sort(key=lambda r: (-r['paid_total'], r['user']))\n\nwith open('report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2)\n\nprint(json.dumps(report, indent=2))\n",
