   "result": "import math\n\n\nclass Vec:\n    def __init__(self, x, y):\n        self.x, self.y = x, y\n\n    def __add__(self, o):\n        return Vec(self.x + o.x, self.y + o.y)\n\n    def norm(self):\n        return math.hypot(self.x, self.y)\n\n\ndef area(points):\n    \"\"\"Shoelace area of a polygon given as Vecs.\"\"\"\n    s = 0.0\n    for a, b in zip(points, points[1:] + points[:1]):\n        s += a.x * b.y - b.x * a.y\n    return abs(s) / 2\n\n\ndef centroid(points):\n    n = len(points)\n    return Vec(sum(p.x for p in points) / n, sum(p.y for p in points) / n)\n"
