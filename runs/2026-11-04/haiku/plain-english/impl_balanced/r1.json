  "brackets.py": "def balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    openers = set(pairs.values())\n    stack = []\n    in_string = False\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        if in_string:\n            if ch == '\\\\':\n                i += 2\n                continue\n            if ch == '\"':\n                in_string = False\n        else:\n            if ch == '\"':\n                in_string = True\n            elif ch in openers:\n                stack.append(ch)\n            elif ch in pairs:\n                if not stack or stack[-1] != pairs[ch]:\n                    return False\n                stack.pop()\n        i += 1\n    if in_string:\n        return False\n    return not stack\n"
 }
