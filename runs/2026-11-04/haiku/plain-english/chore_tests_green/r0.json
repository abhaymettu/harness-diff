 "files": {
  "money.py": "class Money:\n    def __init__(self, cents):\n        self.cents = cents\n\n    def __add__(self, o):\n        return Money(self.cents + o.cents)\n\n    def __eq__(self, o):\n        return isinstance(o, Money) and self.cents == o.cents\n\n    def __repr__(self):\n        return f'Money({self.cents})'\n\n    def __str__(self):\n        sign = '-' if self.cents < 0 else ''\n        dollars, cents = divmod(abs(self.cents), 100)\n        return f'{sign}${dollars:,}.{cents:02d}'\n\n    def split(self, n):\n        sign = -1 if self.cents < 0 else 1\n        total = abs(self.cents)\n        base, extra = divmod(total, n)\n        # The first 'extra' shares get one more cent, so the shares add up exactly.\n        return [Money(sign * (base + (1 if i < extra else 0))) for i in range(n)]\n"
