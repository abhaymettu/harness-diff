 "files": {
  "intervals.py": "def merge(intervals):\n    \"\"\"Merge overlapping or touching [start, end] integer intervals.\n\n    Returns a new list of disjoint intervals sorted by start.\n    The input list is not modified.\n    \"\"\"\n    if not intervals:\n        return []\n\n    # sorted() returns a new list, so the input is left unchanged.\n    ordered = sorted(([start, end] for start, end in intervals), key=lambda p: p[0])\n\n    merged = [list(ordered[0])]\n    for start, end in ordered[1:]:\n        last = merged[-1]\n        if start <= last[1]:\n            # Overlaps or touches the previous interval: extend it.\n            if end > last[1]:\n                last[1] = end\n        else:\n            merged.append([start, end])\n\n    return merged\n"
 }
