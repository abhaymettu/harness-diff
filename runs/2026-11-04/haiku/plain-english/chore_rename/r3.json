  "rename_tmp.py": "import os, re\npat = re.compile(r'\\bcalc\\b')\nfor d, dirs, files in os.walk('.'):\n    dirs[:] = [x for x in dirs if x not in ('.git', '__pycache__')]\n    for f in files:\n        if f.endswith('.py') and f != 'rename_tmp.py':\n            p = os.path.join(d, f)\n            s = open(p, encoding='utf-8').read()\n            n = pat.sub('compute_total', s)\n            if n != s:\n                open(p, 'w', encoding='utf-8').write(n)\n                print('updated', p)\n",
  "shop/cart.py": "from shop.pricing import compute_total\n\n\nclass Cart:\n    def __init__(self):\n        self.items = []\n\n    def add(self, price, qty=1):\n        self.items.append((price, qty))\n\n    def total(self, tax=0.0):\n        return compute_total(self.items, tax)\n",
  "shop/pricing.py": "def compute_total(items, tax=0.0):\n    \"\"\"Total of (price, qty) pairs plus tax.\"\"\"\n    sub = sum(p * q for p, q in items)\n    return round(sub * (1 + tax), 2)\n",
  "shop/report.py": "from shop import pricing\n\n\ndef line(items):\n    return f'total={pricing.compute_total(items)}'\n"
